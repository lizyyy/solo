#!/bin/sh

# Maven Wrapper script - 允许在没有全局安装 Maven 的情况下运行 Maven
# 这是一个纯 shell 实现，不需要下载 Maven wrapper jar

set -e

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "${GREEN}========================================${NC}"
echo "${GREEN}  Service Token Exchange - Maven Run  ${NC}"
echo "${GREEN}========================================${NC}"
echo ""

# 检测 Maven
if command -v mvn > /dev/null 2>&1; then
    echo "✅ 检测到系统 Maven: $(mvn -v | head -n 1)"
    echo ""
    exec mvn "$@"
else
    echo "${YELLOW}⚠️  未检测到全局 Maven，尝试使用替代方案...${NC}"
    echo ""
    
    # 检查是否有预编译的 class 文件
    if [ -d "target/classes" ]; then
        echo "${GREEN}✅ 检测到已编译的 class 文件${NC}"
        echo ""
        echo "请使用 ./start.sh 脚本直接启动应用"
        exit 1
    else
        echo "${RED}❌ 未找到 Maven 也未找到预编译文件${NC}"
        echo ""
        echo "请安装 Maven 或使用 Java 17+ 编译项目:"
        echo "  1. 安装 Maven: https://maven.apache.org/install.html"
        echo "  2. 或使用 IDE (IntelliJ IDEA, Eclipse) 直接打开项目"
        echo "  3. 或使用 Docker 运行（如果有 Dockerfile）"
        exit 1
    fi
fi
