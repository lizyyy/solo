{
  "name": "stock-sim-trader",
  "version": "1.0.0",
  "description": "股票模拟交易复盘和风控预警台",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "seed": "node seeders/seedData.js",
    "client": "cd client && npm run dev",
    "dev-all": "concurrently \"npm run dev\" \"npm run client\"",
    "init": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "sequelize": "^6.33.0",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.10",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "concurrently": "^8.2.2"
  }
}
