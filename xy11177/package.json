{
  "name": "dorm-repair-dispatch",
  "version": "1.0.0",
  "description": "校园宿舍维修队宿舍维修派单 CLI",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "repair-dispatch": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "preview": "node src/index.js preview -i data/repairs.json",
    "dispatch": "node src/index.js dispatch -i data/repairs.json -o output/dispatch.json",
    "report": "node src/index.js report -i output/dispatch.json -o output/report.md"
  },
  "keywords": ["dorm", "repair", "dispatch", "cli"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0"
  }
}
