page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333333;
}

.container {
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-more {
  font-size: 24rpx;
  color: #999999;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #FF6B6B;
}

.primary-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  border-radius: 50rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.primary-btn:active {
  opacity: 0.8;
}

.secondary-btn {
  background-color: #ffffff;
  color: #FF6B6B;
  border-radius: 50rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid #FF6B6B;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background-color: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
}

.tag-success {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.tag-warning {
  background-color: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.tag-info {
  background-color: rgba(24, 144, 255, 0.1);
  color: #1890FF;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: #FF6B6B;
}

.text-success {
  color: #52C41A;
}

.text-warning {
  color: #FAAD14;
}

.text-info {
  color: #1890FF;
}

.text-muted {
  color: #999999;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 30rpx;
}

.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

.tier-3k {
  background: linear-gradient(135deg, #95a5a6, #bdc3c7);
}

.tier-9k {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.tier-3w {
  background: linear-gradient(135deg, #27ae60, #2ecc71);
}

.tier-5w {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
}

.tier-10w {
  background: linear-gradient(135deg, #f39c12, #e67e22);
}

.tier-3k-text {
  color: #95a5a6;
}

.tier-9k-text {
  color: #3498db;
}

.tier-3w-text {
  color: #27ae60;
}

.tier-5w-text {
  color: #9b59b6;
}

.tier-10w-text {
  color: #f39c12;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
