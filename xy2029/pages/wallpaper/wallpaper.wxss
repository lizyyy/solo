.header-section {
  text-align: center;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999999;
}

.tabs-section {
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #666666;
  border-radius: 8rpx;
}

.tab-item.active {
  background-color: #ffffff;
  color: #FF6B6B;
  font-weight: 500;
}

.wall-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.wall-header {
  margin-bottom: 20rpx;
}

.wall-tier-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.wall-tier-badge.tier-3k {
  background-color: #95a5a6;
}

.wall-tier-badge.tier-9k {
  background-color: #3498db;
}

.wall-tier-badge.tier-3w {
  background-color: #27ae60;
}

.wall-tier-badge.tier-5w {
  background-color: #9b59b6;
}

.wall-tier-badge.tier-10w {
  background-color: #f39c12;
}

.wall-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  font-style: italic;
  margin-bottom: 20rpx;
}

.wall-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.action-btn {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
}

.moment-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.moment-scene {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.moment-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  font-style: italic;
  margin-bottom: 16rpx;
}

.moment-tags {
  margin-bottom: 20rpx;
}

.moment-tag {
  font-size: 22rpx;
  color: #999999;
  margin-right: 12rpx;
}

.healing-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.healing-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.healing-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  font-style: italic;
  margin-bottom: 20rpx;
}

.bottom-space {
  height: 40rpx;
}
