.header-section {
  text-align: center;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999999;
}

.tier-cards {
  
}

.tier-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.tier-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.tier-card.tier-3k::before {
  background-color: #95a5a6;
}

.tier-card.tier-9k::before {
  background-color: #3498db;
}

.tier-card.tier-3w::before {
  background-color: #27ae60;
}

.tier-card.tier-5w::before {
  background-color: #9b59b6;
}

.tier-card.tier-10w::before {
  background-color: #f39c12;
}

.tier-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.tier-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.tier-mode {
  font-size: 24rpx;
  color: #999999;
  padding: 6rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.tier-salary-range {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.tier-features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.feature-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #666666;
}

.tier-go-detail {
  font-size: 24rpx;
  color: #FF6B6B;
  text-align: right;
}

.comparison-table {
  padding: 30rpx;
  margin-top: 30rpx;
}

.table-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  text-align: center;
}

.table-header {
  display: flex;
  border-bottom: 2rpx solid #e0e0e0;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.header-col {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B6B;
}

.header-col.empty-col {
  width: 120rpx;
  flex: none;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row-label {
  width: 120rpx;
  flex: none;
  font-size: 22rpx;
  color: #666666;
}

.row-values {
  flex: 1;
  display: flex;
}

.value-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
}

.bottom-space {
  height: 40rpx;
}
