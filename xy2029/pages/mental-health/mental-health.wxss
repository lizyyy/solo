.header-banner {
  background: linear-gradient(135deg, #27ae60, #2ecc71);
  color: #ffffff;
  text-align: center;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.banner-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.daily-quote {
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.quote-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.quote-text {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 20rpx;
}

.quote-refresh {
  font-size: 26rpx;
  color: #FF6B6B;
  text-align: right;
}

.tabs-section {
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-radius: 8rpx;
}

.tab-item.active {
  background-color: #ffffff;
  color: #27ae60;
  font-weight: 500;
}

.story-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.story-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.story-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.story-user {
  display: flex;
  flex-direction: column;
}

.story-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.story-tier {
  font-size: 22rpx;
  color: #999999;
}

.story-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.story-stats {
  display: flex;
  gap: 24rpx;
}

.stat {
  font-size: 24rpx;
  color: #999999;
}

.warning-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #FF6B6B;
}

.warning-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.warning-content {
  flex: 1;
}

.warning-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.warning-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.article-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.article-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.article-preview {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-category {
  font-size: 22rpx;
  color: #27ae60;
  padding: 4rpx 12rpx;
  background-color: rgba(39, 174, 96, 0.1);
  border-radius: 4rpx;
}

.article-read {
  font-size: 22rpx;
  color: #999999;
}

.bottom-space {
  height: 40rpx;
}
