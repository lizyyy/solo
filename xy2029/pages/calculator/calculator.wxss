.input-section {
  
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.input-container {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
}

.input-prefix {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF6B6B;
  margin-right: 16rpx;
}

.salary-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.input-placeholder {
  color: #999999;
  font-weight: normal;
}

.quick-tier {
  
}

.quick-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

.tier-buttons {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.tier-btn {
  padding: 16rpx 24rpx;
  margin: 8rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
}

.tier-btn.active {
  background-color: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
  border-color: #FF6B6B;
}

.calc-btn {
  margin-top: 30rpx;
}

.result-section {
  
}

.result-header {
  
}

.result-tier-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tier-badge {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.tier-badge.tier-3k {
  background: linear-gradient(135deg, #95a5a6, #bdc3c7);
}

.tier-badge.tier-9k {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.tier-badge.tier-3w {
  background: linear-gradient(135deg, #27ae60, #2ecc71);
}

.tier-badge.tier-5w {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
}

.tier-badge.tier-10w {
  background: linear-gradient(135deg, #f39c12, #e67e22);
}

.tier-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tier-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.result-salary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.salary-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.salary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.tier-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.allocation-card {
  
}

.allocation-tip {
  font-size: 22rpx;
  color: #999999;
}

.allocation-chart {
  margin-bottom: 30rpx;
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 10rpx;
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.legend-text {
  display: flex;
  flex-direction: column;
}

.legend-name {
  font-size: 24rpx;
  color: #333333;
}

.legend-ratio {
  font-size: 20rpx;
  color: #999999;
}

.allocation-list {
  
}

.allocation-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.allocation-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 10rpx;
}

.item-bar {
  display: flex;
  align-items: center;
}

.bar-bg {
  flex: 1;
  height: 12rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.bar-ratio {
  font-size: 22rpx;
  color: #999999;
  min-width: 50rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.item-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.item-tip {
  font-size: 20rpx;
  color: #999999;
}

.summary-card {
  
}

.summary-content {
  
}

.summary-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.summary-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.summary-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.summary-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  margin: 30rpx -10rpx 0;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
}

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.empty-tip {
  font-size: 24rpx;
  color: #999999;
}

.bottom-space {
  height: 40rpx;
}
