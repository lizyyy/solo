{
  "resources": {
    "deployments": [
      {
        "metadata": {
          "name": "nginx"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "nginx",
                  "image": "nginx:1.21.0",
                  "resources": {
                    "limits": {
                      "cpu": "3",
                      "memory": "4Gi"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    ],
    "statefulsets": []
  }
}
