from fastapi import FastAPI, Depends, HTTPException, Query
from sqlalchemy.orm import Session
from datetime import datetime
from typing import List, Optional, Dict, Any
from pydantic import BaseModel, Field
import json
from io import BytesIO
from fastapi.responses import StreamingResponse

from app.database import engine, get_db, Base
from app.models import (
    MaintenanceWindow, ConstructionTeam, PowerPlan, TrainWindow,
    StatusHistory, ConflictRecord, WindowProcessor, Processor
)

Base.metadata.create_all(bind=engine)

app = FastAPI(title="铁路天窗维修 API", version="1.0.0")


class ConstructionTeamCreate(BaseModel):
    name: str = Field(..., description="施工队名称")
    team_type: str = Field(..., description="施工队类型")
    contact: Optional[str] = Field(None, description="联系方式")


class PowerPlanCreate(BaseModel):
    power_off_area: str = Field(..., description="停电区域")
    start_time: datetime = Field(..., description="开始时间")
    end_time: datetime = Field(..., description="结束时间")
    operator: Optional[str] = Field(None, description="操作人员")


class TrainWindowCreate(BaseModel):
    train_number: str = Field(..., description="车次号")
    start_station: str = Field(..., description="始发站")
    end_station: str = Field(..., description="终点站")
    arrival_time: datetime = Field(..., description="到达时间")
    departure_time: datetime = Field(..., description="发车时间")


class MaintenanceWindowCreate(BaseModel):
    window_type: str = Field(..., description="天窗类型")
    line: str = Field(..., description="线路")
    start_station: str = Field(..., description="起始站")
    end_station: str = Field(..., description="终点站")
    start_time: datetime = Field(..., description="开始时间")
    end_time: datetime = Field(..., description="结束时间")
    work_content: str = Field(..., description="作业内容")
    construction_unit: str = Field(..., description="施工单位")
    batch_id: Optional[str] = Field(None, description="批次ID")


class MaintenanceWindowUpdate(BaseModel):
    window_type: Optional[str] = None
    line: Optional[str] = None
    start_station: Optional[str] = None
    end_station: Optional[str] = None
    start_time: Optional[datetime] = None
    end_time: Optional[datetime] = None
    work_content: Optional[str] = None
    construction_unit: Optional[str] = None


class CloseWindowRequest(BaseModel):
    actual_end_time: datetime = Field(..., description="实际结束时间")
    completion_status: str = Field(..., description="完成状态")
    remarks: Optional[str] = Field(None, description="备注")


class BatchSubmitRequest(BaseModel):
    window_ids: List[int] = Field(..., description="天窗ID列表")
    batch_name: str = Field(..., description="批次名称")


class ProcessorCreate(BaseModel):
    name: str = Field(..., description="处理人姓名")
    role: str = Field(..., description="角色")
    department: Optional[str] = Field(None, description="部门")


def check_time_overlap(start1: datetime, end1: datetime, start2: datetime, end2: datetime) -> bool:
    return start1 < end2 and start2 < end1


def add_status_history(db: Session, window_id: int, from_status: str, to_status: str,
                       operator: Optional[str] = None, remarks: Optional[str] = None):
    history = StatusHistory(
        window_id=window_id,
        from_status=from_status,
        to_status=to_status,
        operator=operator,
        remarks=remarks,
        change_time=datetime.now()
    )
    db.add(history)
    db.commit()
    db.refresh(history)
    return history


def add_processor_record(db: Session, window_id: int, processor_name: str,
                         role: Optional[str] = None, action: Optional[str] = None):
    record = WindowProcessor(
        window_id=window_id,
        processor_name=processor_name,
        role=role,
        action=action,
        process_time=datetime.now()
    )
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def add_conflict_record(db: Session, window_id: int, conflict_type: str,
                        description: str, related_window_id: Optional[int] = None,
                        resolved: bool = False):
    conflict = ConflictRecord(
        window_id=window_id,
        conflict_type=conflict_type,
        description=description,
        related_window_id=related_window_id,
        resolved=resolved,
        detected_time=datetime.now()
    )
    db.add(conflict)
    db.commit()
    db.refresh(conflict)
    return conflict


def detect_comprehensive_conflicts(db: Session, window: MaintenanceWindow) -> List[Dict[str, Any]]:
    conflicts = []
    
    existing_windows = db.query(MaintenanceWindow).filter(
        MaintenanceWindow.id != window.id,
        MaintenanceWindow.status != "cancelled"
    ).all()
    
    for existing in existing_windows:
        if check_time_overlap(window.start_time, window.end_time, existing.start_time, existing.end_time):
            if window.line == existing.line:
                conflicts.append({
                    "type": "时间冲突",
                    "related_window_id": existing.id,
                    "description": f"与天窗#{existing.id}在同一线路上时间重叠"
                })
        
        if window.construction_unit == existing.construction_unit:
            if check_time_overlap(window.start_time, window.end_time, existing.start_time, existing.end_time):
                conflicts.append({
                    "type": "施工队冲突",
                    "related_window_id": existing.id,
                    "description": f"施工队同一时间在天窗#{existing.id}有作业"
                })
    
    power_plans = db.query(PowerPlan).filter(
        PowerPlan.confirmed == True
    ).all()
    
    for plan in power_plans:
        if not check_time_overlap(window.start_time, window.end_time, plan.start_time, plan.end_time):
            conflicts.append({
                "type": "供电冲突",
                "related_window_id": None,
                "description": f"作业时间与停电计划不匹配"
            })
    
    return conflicts


def window_to_dict(window: MaintenanceWindow, include_details: bool = False) -> Dict[str, Any]:
    result = {
        "id": window.id,
        "window_type": window.window_type,
        "line": window.line,
        "start_station": window.start_station,
        "end_station": window.end_station,
        "start_time": window.start_time.isoformat() if window.start_time else None,
        "end_time": window.end_time.isoformat() if window.end_time else None,
        "work_content": window.work_content,
        "construction_unit": window.construction_unit,
        "status": window.status,
        "batch_id": window.batch_id,
        "created_at": window.created_at.isoformat() if window.created_at else None
    }
    
    if include_details:
        result["teams"] = [{"id": t.id, "name": t.name, "team_type": t.team_type} for t in window.teams]
        result["power_plans"] = [{"id": p.id, "power_off_area": p.power_off_area, "confirmed": p.confirmed} for p in window.power_plans]
        result["train_windows"] = [{"id": tw.id, "train_number": tw.train_number, "confirmed": tw.confirmed} for tw in window.train_windows]
    
    return result


@app.get("/")
def root():
    return {"message": "铁路天窗维修 API 服务运行中", "version": "1.0.0"}


@app.get("/health")
def health_check():
    return {"status": "healthy", "timestamp": datetime.now().isoformat()}


@app.post("/teams/{window_id}")
def add_construction_team(window_id: int, team_data: ConstructionTeamCreate, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    team = ConstructionTeam(
        window_id=window_id,
        name=team_data.name,
        team_type=team_data.team_type,
        contact=team_data.contact
    )
    db.add(team)
    db.commit()
    db.refresh(team)
    
    return {"id": team.id, "name": team.name, "team_type": team.team_type}


@app.get("/teams/{window_id}")
def get_construction_teams(window_id: int, db: Session = Depends(get_db)):
    teams = db.query(ConstructionTeam).filter(ConstructionTeam.window_id == window_id).all()
    return [{"id": t.id, "name": t.name, "team_type": t.team_type, "contact": t.contact} for t in teams]


@app.post("/power/{window_id}")
def create_power_plan(window_id: int, plan_data: PowerPlanCreate, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    plan = PowerPlan(
        window_id=window_id,
        power_off_area=plan_data.power_off_area,
        start_time=plan_data.start_time,
        end_time=plan_data.end_time,
        operator=plan_data.operator,
        confirmed=False
    )
    db.add(plan)
    db.commit()
    db.refresh(plan)
    
    return {"id": plan.id, "power_off_area": plan.power_off_area, "confirmed": plan.confirmed}


@app.post("/power/{plan_id}/confirm")
def confirm_power_plan(plan_id: int, db: Session = Depends(get_db)):
    plan = db.query(PowerPlan).filter(PowerPlan.id == plan_id).first()
    if not plan:
        raise HTTPException(status_code=404, detail="停电计划不存在")
    
    plan.confirmed = True
    db.commit()
    db.refresh(plan)
    
    return {"id": plan.id, "confirmed": plan.confirmed}


@app.get("/power/{window_id}")
def get_power_plans(window_id: int, db: Session = Depends(get_db)):
    plans = db.query(PowerPlan).filter(PowerPlan.window_id == window_id).all()
    return [{"id": p.id, "power_off_area": p.power_off_area, "confirmed": p.confirmed} for p in plans]


@app.post("/trains/{window_id}")
def create_train_window(window_id: int, train_data: TrainWindowCreate, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    train = TrainWindow(
        window_id=window_id,
        train_number=train_data.train_number,
        start_station=train_data.start_station,
        end_station=train_data.end_station,
        arrival_time=train_data.arrival_time,
        departure_time=train_data.departure_time,
        confirmed=False
    )
    db.add(train)
    db.commit()
    db.refresh(train)
    
    return {"id": train.id, "train_number": train.train_number, "confirmed": train.confirmed}


@app.post("/trains/{train_id}/confirm")
def confirm_train_window(train_id: int, db: Session = Depends(get_db)):
    train = db.query(TrainWindow).filter(TrainWindow.id == train_id).first()
    if not train:
        raise HTTPException(status_code=404, detail="列车窗口不存在")
    
    train.confirmed = True
    db.commit()
    db.refresh(train)
    
    return {"id": train.id, "confirmed": train.confirmed}


@app.post("/windows/", response_model=Dict[str, Any])
def create_window(window_data: MaintenanceWindowCreate, db: Session = Depends(get_db)):
    window = MaintenanceWindow(
        window_type=window_data.window_type,
        line=window_data.line,
        start_station=window_data.start_station,
        end_station=window_data.end_station,
        start_time=window_data.start_time,
        end_time=window_data.end_time,
        work_content=window_data.work_content,
        construction_unit=window_data.construction_unit,
        batch_id=window_data.batch_id,
        status="draft"
    )
    db.add(window)
    db.commit()
    db.refresh(window)
    
    add_status_history(db, window.id, "", "draft", remarks="创建天窗")
    
    return window_to_dict(window)


@app.get("/windows/")
def list_windows(skip: int = 0, limit: int = 100, status: Optional[str] = None, db: Session = Depends(get_db)):
    query = db.query(MaintenanceWindow)
    if status:
        query = query.filter(MaintenanceWindow.status == status)
    
    windows = query.offset(skip).limit(limit).all()
    return [window_to_dict(w) for w in windows]


@app.get("/windows/{window_id}")
def get_window(window_id: int, include_details: bool = True, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    return window_to_dict(window, include_details=include_details)


@app.put("/windows/{window_id}")
def update_window(window_id: int, window_data: MaintenanceWindowUpdate, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    update_data = window_data.dict(exclude_unset=True)
    for key, value in update_data.items():
        setattr(window, key, value)
    
    db.commit()
    db.refresh(window)
    
    return window_to_dict(window)


@app.post("/windows/{window_id}/validate")
def validate_window(window_id: int, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    conflicts = detect_comprehensive_conflicts(db, window)
    
    for conflict in conflicts:
        add_conflict_record(
            db, window_id,
            conflict["type"],
            conflict["description"],
            conflict.get("related_window_id")
        )
    
    if conflicts:
        return {"valid": False, "conflicts": conflicts}
    
    old_status = window.status
    window.status = "validated"
    db.commit()
    
    add_status_history(db, window_id, old_status, "validated", remarks="校验通过")
    
    return {"valid": True, "message": "校验通过"}


@app.post("/windows/{window_id}/approve")
def approve_window(window_id: int, processor: str, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    if window.status != "validated":
        raise HTTPException(status_code=400, detail="天窗未通过校验，无法审批")
    
    old_status = window.status
    window.status = "approved"
    db.commit()
    
    add_status_history(db, window_id, old_status, "approved", operator=processor, remarks="审批通过")
    add_processor_record(db, window_id, processor, role="审批人", action="审批通过")
    
    return {"status": "approved", "window_id": window_id}


@app.post("/windows/{window_id}/reject")
def reject_window(window_id: int, processor: str, reason: str, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    old_status = window.status
    window.status = "rejected"
    db.commit()
    
    add_status_history(db, window_id, old_status, "rejected", operator=processor, remarks=reason)
    add_processor_record(db, window_id, processor, role="审批人", action="驳回")
    
    return {"status": "rejected", "window_id": window_id, "reason": reason}


@app.post("/windows/{window_id}/close")
def close_window(window_id: int, close_data: CloseWindowRequest, db: Session = Depends(get_db)):
    window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
    if not window:
        raise HTTPException(status_code=404, detail="天窗不存在")
    
    if window.status not in ["approved", "in_progress"]:
        raise HTTPException(status_code=400, detail="天窗状态不允许关闭")
    
    old_status = window.status
    window.status = "closed"
    window.actual_end_time = close_data.actual_end_time
    window.completion_status = close_data.completion_status
    window.remarks = close_data.remarks
    db.commit()
    
    add_status_history(db, window_id, old_status, "closed", remarks=close_data.remarks)
    
    return {"status": "closed", "window_id": window_id, "completion_status": close_data.completion_status}


@app.post("/batch/submit")
def batch_submit_windows(batch_data: BatchSubmitRequest, db: Session = Depends(get_db)):
    results = []
    
    for window_id in batch_data.window_ids:
        window = db.query(MaintenanceWindow).filter(MaintenanceWindow.id == window_id).first()
        if window:
            window.batch_id = batch_data.batch_name
            window.status = "submitted"
            db.commit()
            results.append({"window_id": window_id, "success": True})
        else:
            results.append({"window_id": window_id, "success": False, "reason": "天窗不存在"})
    
    return {"batch_name": batch_data.batch_name, "results": results}


@app.get("/batch/{batch_id}")
def get_batch_windows(batch_id: str, db: Session = Depends(get_db)):
    windows = db.query(MaintenanceWindow).filter(MaintenanceWindow.batch_id == batch_id).all()
    return {
        "batch_id": batch_id,
        "count": len(windows),
        "windows": [window_to_dict(w) for w in windows]
    }


@app.get("/conflicts/{window_id}")
def get_window_conflicts(window_id: int, db: Session = Depends(get_db)):
    conflicts = db.query(ConflictRecord).filter(ConflictRecord.window_id == window_id).all()
    return [
        {
            "id": c.id,
            "type": c.conflict_type,
            "description": c.description,
            "related_window_id": c.related_window_id,
            "resolved": c.resolved,
            "detected_time": c.detected_time.isoformat() if c.detected_time else None
        }
        for c in conflicts
    ]


@app.post("/conflicts/{conflict_id}/resolve")
def resolve_conflict(conflict_id: int, resolution: str, db: Session = Depends(get_db)):
    conflict = db.query(ConflictRecord).filter(ConflictRecord.id == conflict_id).first()
    if not conflict:
        raise HTTPException(status_code=404, detail="冲突记录不存在")
    
    conflict.resolved = True
    conflict.resolution = resolution
    conflict.resolved_time = datetime.now()
    db.commit()
    
    return {"id": conflict_id, "resolved": True, "resolution": resolution}


@app.get("/history/{window_id}")
def get_window_history(window_id: int, db: Session = Depends(get_db)):
    history = db.query(StatusHistory).filter(StatusHistory.window_id == window_id).order_by(StatusHistory.change_time).all()
    return [
        {
            "id": h.id,
            "from_status": h.from_status,
            "to_status": h.to_status,
            "operator": h.operator,
            "remarks": h.remarks,
            "change_time": h.change_time.isoformat() if h.change_time else None
        }
        for h in history
    ]


@app.get("/export")
def export_windows(db: Session = Depends(get_db)):
    windows = db.query(MaintenanceWindow).all()
    export_data = [window_to_dict(w, include_details=True) for w in windows]
    
    json_data = json.dumps(export_data, ensure_ascii=False, indent=2)
    bytes_io = BytesIO(json_data.encode('utf-8'))
    
    return StreamingResponse(
        bytes_io,
        media_type="application/json",
        headers={"Content-Disposition": f"attachment; filename=windows_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"}
    )


@app.post("/processors")
def create_processor(processor_data: ProcessorCreate, db: Session = Depends(get_db)):
    processor = Processor(
        name=processor_data.name,
        role=processor_data.role,
        department=processor_data.department
    )
    db.add(processor)
    db.commit()
    db.refresh(processor)
    
    return {"id": processor.id, "name": processor.name, "role": processor.role, "department": processor.department}


@app.get("/processors")
def get_processors(db: Session = Depends(get_db)):
    processors = db.query(Processor).all()
    return [{"id": p.id, "name": p.name, "role": p.role, "department": p.department} for p in processors]
