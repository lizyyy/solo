{
  "name": "release-audit-cli",
  "version": "1.0.0",
  "description": "CLI for pre-release software artifact audit",
  "main": "dist/index.js",
  "bin": {
    "release-audit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "demo": "npm run build && node dist/cli.js --artifacts sample/artifacts.json --sbom sample/sbom.json --provenance sample/provenance.jsonl --policy sample/policy.yaml --output output",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["audit", "release", "sbom", "slsa", "provenance"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0"
  }
}
