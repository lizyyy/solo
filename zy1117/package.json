{
  "name": "quote-contract-reconciler",
  "version": "1.0.0",
  "description": "售前报价和合同交付差异核对工具",
  "main": "src/index.js",
  "bin": {
    "qcrecon": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node tests/run-tests.js",
    "sample:scan": "node src/cli.js scan samples/normal",
    "sample:report": "node src/cli.js report samples/normal -o reports/normal",
    "abnormal:scan": "node src/cli.js scan samples/abnormal",
    "abnormal:report": "node src/cli.js report samples/abnormal -o reports/abnormal"
  },
  "keywords": [
    "报价",
    "合同",
    "差异核对",
    "报价单",
    "合同草稿"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.10",
    "iconv-lite": "^0.6.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
