{
  "project_id": "demo_success_001",
  "name": "2026Q1 指标口径优化项目",
  "description": "优化三个核心指标口径：GMV(排除测试订单)、活跃用户(修正定义)、退款率(重命名)",
  "metrics": {
    "gmv_v1": {
      "metric_id": "gmv_v1",
      "name": "总GMV",
      "type": "counter",
      "sql": "SELECT SUM(amount) FROM orders WHERE status = 'completed' AND is_test = false",
      "aggregation": "sum",
      "time_window": "daily",
      "filters": {
        "status": "completed",
        "is_test": false
      },
      "business_owner": "wang_fan@example.com",
      "tech_owner": "zhang_wei@example.com",
      "created_at": {
        "__type__": "datetime",
        "value": "2025-11-13T17:17:22.167587"
      },
      "updated_at": {
        "__type__": "datetime",
        "value": "2026-05-12T17:17:22.167591"
      }
    },
    "dau_v2": {
      "metric_id": "dau_v2",
      "name": "日活跃用户(修正版)",
      "type": "counter",
      "sql": "SELECT COUNT(DISTINCT user_id) FROM user_activity WHERE activity_date = CURDATE() AND duration >= 30",
      "aggregation": "count_distinct",
      "time_window": "daily",
      "filters": {
        "activity_date": "today",
        "min_duration": 30
      },
      "business_owner": "li_na@example.com",
      "tech_owner": "chen_hong@example.com",
      "created_at": {
        "__type__": "datetime",
        "value": "2025-05-12T17:17:22.167613"
      },
      "updated_at": {
        "__type__": "datetime",
        "value": "2026-05-12T17:17:22.167615"
      }
    },
    "refund_rate": {
      "metric_id": "refund_rate",
      "name": "退款率",
      "type": "ratio",
      "sql": "SELECT SUM(refund_amount) / SUM(total_amount) FROM orders WHERE created_at >= DATE_SUB(NOW(), INTERVAL 7 DAY)",
      "aggregation": "ratio",
      "time_window": "weekly",
      "filters": {
        "time_window": "7_days"
      },
      "business_owner": "zhao_qiang@example.com",
      "tech_owner": "sun_ming@example.com",
      "created_at": {
        "__type__": "datetime",
        "value": "2026-02-11T17:17:22.167638"
      },
      "updated_at": {
        "__type__": "datetime",
        "value": "2026-05-12T17:17:22.167639"
      }
    }
  },
