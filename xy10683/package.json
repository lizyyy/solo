{
  "name": "restaurant-queue-system",
  "version": "1.0.0",
  "description": "餐厅排号拼桌过号系统",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
