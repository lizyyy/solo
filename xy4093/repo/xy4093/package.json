{
  "name": "typhoon-evacuation-system",
  "version": "1.0.0",
  "description": "海岛民宿台风撤房物资联动表系统",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "cd client && npm run dev",
    "test": "node --test test/",
    "init-db": "node server/scripts/init-db.js",
    "seed-data": "node server/scripts/seed-data.js"
  },
  "keywords": ["typhoon", "evacuation", "hotel", "management"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
