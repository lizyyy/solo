{
  "name": "course-discount-api",
  "version": "1.0.0",
  "description": "课程优惠叠加 API - 处理优惠券、团购价、老学员折扣和退款的规则叠加",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "init-db": "node src/scripts/initDb.js",
    "seed": "node src/scripts/seedData.js",
    "reset": "npm run init-db && npm run seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "dayjs": "^1.11.10"
  }
}
