#!/bin/sh

set -e

MAVEN_VERSION="3.9.9"
INSTALL_DIR="$HOME/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="$INSTALL_DIR/bin/mvn"

# 检查 Maven 是否已安装
if [ ! -f "$MAVEN_BIN" ]; then
    echo "======================================================================"
    echo "  Maven 未找到，正在自动安装..."
    echo "======================================================================"
    echo ""
    
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    "$SCRIPT_DIR/bootstrap-maven.sh"
    
    # 重新加载环境变量
    export M2_HOME="$INSTALL_DIR"
    export PATH="$M2_HOME/bin:$PATH"
fi

# 设置 Maven 已安装，执行命令
export M2_HOME="$INSTALL_DIR"
export PATH="$M2_HOME/bin:$PATH"

# 确认 Maven 存在
if [ ! -f "$MAVEN_BIN" ]; then
    echo "❌ Maven 安装失败"
    exit 1
fi

echo "✅ 使用 Maven: $MAVEN_BIN"
echo ""

exec "$MAVEN_BIN" "$@"
