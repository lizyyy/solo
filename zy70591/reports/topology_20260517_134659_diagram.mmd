%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '14px'}} }%%
graph TD
    %% 样式定义
    classDef exchange fill:#e3f2fd,stroke:#2196f3,stroke-width:2px,rounded;
    classDef queue fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px,rounded;
    classDef binding fill:#fff,stroke:#ccc,stroke-width:1px;
    classDef orphan fill:#ffebee,stroke:#f44336,stroke-width:2px,rounded,stroke-dasharray: 5 5;

    subgraph _ ["Vhost: /"]
        direction TB

        __good_exchange["<b>good.exchange</b><br/><i>direct</i>"]:::exchange

        __test_queue["<b>test.queue</b><br/><i>queue</i>"]:::queue
    end

    __nonexistent_exchange --> |test| __test_queue
    __good_exchange --> |fanout| __nonexistent_queue