{
  "name": "pump-room-inspection",
  "version": "1.0.0",
  "description": "小区地下泵房巡检管理系统",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "init-db": "node server/scripts/init-db.js",
    "import-inspection": "node server/scripts/import-inspection.js",
    "import-alarm": "node server/scripts/import-alarm.js",
