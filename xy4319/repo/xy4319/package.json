{
  "name": "triage-transfer-pressure-test-platform",
  "version": "1.0.0",
  "description": "医院急诊演练用的分诊转运压测台 - 全栈Web应用",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "医院",
    "急诊",
    "演练",
    "分诊",
    "转运",
    "医疗"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "date-fns": "^3.0.6",
    "csv-writer": "^1.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
