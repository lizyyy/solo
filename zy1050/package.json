{
  "name": "sqlite-migration-checker",
  "version": "1.0.0",
  "description": "SQLite 迁移回放和回滚风险体检 CLI 工具",
  "main": "src/index.js",
  "bin": {
    "sqlite-migration-checker": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node src/cli.js check --migrations-dir ./examples/migrations --config ./examples/config.yaml --output ./examples/report"
  },
  "keywords": [
    "sqlite",
    "migration",
    "rollback",
    "diff",
    "schema",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "yargs": "^17.7.2",
    "js-yaml": "^4.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
