{
  "name": "exam-monitor-extension",
  "version": "1.0.0",
  "description": "考场异常标记夹 - 浏览器扩展",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "考场异常标记夹"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
