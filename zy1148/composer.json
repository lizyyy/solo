{
    "name": "php-security-scanner/cli",
    "description": "PHP 项目安全扫描 CLI 工具",
    "type": "library",
    "require": {
        "php": ">=8.0",
        "symfony/console": "^6.0",
        "symfony/yaml": "^6.0",
        "composer/semver": "^3.4",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "PhpSecurityScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSecurityScanner\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/scansec"
    ],
    "config": {
        "sort-packages": true
    }
}
