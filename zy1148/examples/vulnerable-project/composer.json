{
    "name": "vulnerable/seed-project",
    "description": "故意包含安全漏洞的测试项目 - 仅用于测试安全扫描器",
    "type": "project",
    "require": {
        "php": ">=7.0",
        "guzzlehttp/guzzle": "6.3.0",
        "symfony/http-kernel": "5.4.0",
        "laravel/framework": "8.0.0",
        "phpmailer/phpmailer": "6.0.0",
        "twig/twig": "2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "7.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "secure-http": false
    }
}
