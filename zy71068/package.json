{
  "name": "font-license-audit",
  "version": "1.0.0",
  "description": "字体资产授权审计 CLI 工具 - 扫描字体文件、CSS引用、授权清单，生成合规报告",
  "main": "dist/index.js",
  "bin": {
    "font-license": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "self-test": "node dist/index.js self-test",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "font",
    "license",
    "audit",
    "cli",
    "compliance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "css-tree": "^2.3.1",
    "glob": "^10.4.1",
    "lodash": "^4.17.21",
    "table": "^6.8.2"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.8",
    "@types/lodash": "^4.17.4",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
