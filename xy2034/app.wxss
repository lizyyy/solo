page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  color: #333333;
}

.container {
  padding: 20rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background-color: #6B8DD6;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary:active {
  background-color: #5a7bc5;
}

.btn-secondary {
  background-color: #ffffff;
  color: #6B8DD6;
  border: 2rpx solid #6B8DD6;
  border-radius: 8rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: #6B8DD6;
}

.text-secondary {
  color: #999999;
}

.text-danger {
  color: #ff6b6b;
}

.text-success {
  color: #51cf66;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-40 {
  margin-top: 40rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-40 {
  margin-bottom: 40rpx;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  background-color: #ffffff;
  font-size: 28rpx;
}

.input:focus {
  border-color: #6B8DD6;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  background-color: #ffffff;
  font-size: 28rpx;
  line-height: 1.6;
}

.textarea:focus {
  border-color: #6B8DD6;
}
