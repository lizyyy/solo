.user-card {
  background: linear-gradient(135deg, #6B8DD6 0%, #8BA4E8 100%);
  color: #fff;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  color: #fff;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
}

.user-desc,
.login-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.ml-30 {
  margin-left: 30rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.align-center {
  align-items: center;
}

.stats-row {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}

.stat-item {
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.menu-section {
  margin-top: 20rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.menu-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #333;
  margin-left: 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.moments-section,
.test-section {
  margin-top: 20rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.more-text {
  font-size: 26rpx;
}

.moments-list {
  margin-top: 10rpx;
}

.moment-item {
  padding: 20rpx;
  background-color: #f9fafc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.moment-item:last-child {
  margin-bottom: 0;
}

.moment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.moment-footer {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.test-list {
  margin-top: 10rpx;
}

.test-item {
  padding: 20rpx;
  background-color: #f9fafc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.test-item:last-child {
  margin-bottom: 0;
}

.test-info {
  margin-bottom: 8rpx;
}

.test-date {
  font-size: 26rpx;
  color: #666;
}

.test-level {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.test-level.mild {
  background-color: #e3f2fd;
  color: #1976d2;
}

.test-level.moderate {
  background-color: #fff3e0;
  color: #f57c00;
}

.test-level.severe {
  background-color: #ffebee;
  color: #d32f2f;
}

.test-score {
  font-size: 26rpx;
  color: #666;
}

.logout-section {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.logout-btn {
  background-color: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  width: 100%;
}

.logout-btn:active {
  background-color: #fff5f5;
}

.footer-info {
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
