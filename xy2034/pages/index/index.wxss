.user-section {
  margin-bottom: 30rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.user-desc {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.welcome-section {
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #6B8DD6;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 28rpx;
  line-height: 1.6;
}

.modules-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #333;
}

.modules-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.module-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.module-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.module-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 16rpx;
  border-radius: 12rpx;
}

.module-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 22rpx;
}

.footer-text {
  font-size: 24rpx;
  padding: 40rpx 0;
  color: #999;
}
