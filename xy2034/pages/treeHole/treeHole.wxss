.tips-section {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  color: #fff;
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.tips-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tips-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.post-count {
  font-size: 24rpx;
}

.post-item {
  margin-bottom: 24rpx;
}

.post-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-footer {
  align-items: center;
}

.post-time {
  font-size: 22rpx;
}

.post-stats {
  display: flex;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.stat-text {
  font-size: 22rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.create-post-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 36rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(107, 141, 214, 0.4);
  z-index: 100;
}

.btn-icon {
  font-size: 36rpx;
  font-weight: 300;
  margin-right: 10rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}
