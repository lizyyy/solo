.profile-section {
  margin-bottom: 30rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #e0e0e0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.user-stats {
  display: flex;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.action-buttons {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.follow {
  background-color: #6B8DD6;
  color: #fff;
  margin-right: 16rpx;
}

.action-btn.unfollow {
  background-color: #f0f0f0;
  color: #666;
  margin-right: 16rpx;
}

.action-btn.secondary {
  background-color: #fff;
  color: #6B8DD6;
  border: 2rpx solid #6B8DD6;
}

.login-prompt {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.prompt-text {
  font-size: 24rpx;
}

.login-btn {
  background-color: #6B8DD6;
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.moments-section {
  
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.moment-count {
  font-size: 24rpx;
}

.moments-list {
  
}

.moment-item {
  margin-bottom: 20rpx;
}

.moment-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.moment-footer {
  align-items: center;
}

.post-time {
  font-size: 22rpx;
}

.moment-stats {
  display: flex;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.stat-text {
  font-size: 22rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  line-height: 1.5;
}
