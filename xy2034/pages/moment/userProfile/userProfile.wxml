<view class="container">
  <!-- 用户信息 -->
  <view class="profile-section card" wx:if="{{user}}">
    <view class="profile-header">
      <image class="user-avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view class="user-info">
        <view class="user-name">{{user.userName}}</view>
        <view class="user-stats">
          <view class="stat-item">
            <text class="stat-value">{{user.posts}}</text>
            <text class="stat-label">动态</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{user.friends}}</text>
            <text class="stat-label">关注</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{user.followers}}</text>
            <text class="stat-label">粉丝</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons" wx:if="{{isLoggedIn}}">
      <view 
        class="action-btn {{isFriend ? 'unfollow' : 'follow'}}" 
        bindtap="toggleFriend"
      >
        {{isFriend ? '已关注' : '关注'}}
      </view>
      <view class="action-btn secondary">
        私信
      </view>
    </view>

    <!-- 登录提示 -->
    <view class="login-prompt" wx:else>
      <view class="prompt-text text-secondary">登录后可以关注用户</view>
      <view class="login-btn" bindtap="handleLogin">立即登录</view>
    </view>
  </view>

  <!-- 用户动态 -->
  <view class="moments-section">
    <view class="section-header">
      <view class="section-title">TA的动态</view>
      <view class="moment-count text-secondary">{{userMoments.length}} 条</view>
    </view>

    <view class="moments-list" wx:if="{{userMoments.length > 0}}">
      <view 
        class="moment-item card" 
        wx:for="{{userMoments}}" 
        wx:key="id"
        bindtap="goToMomentDetail"
        data-id="{{item.id}}"
      >
        <view class="moment-content">
          {{item.content}}
        </view>
        <view class="moment-footer flex flex-between">
          <view class="post-time text-secondary">
            {{item.createTime}}
          </view>
          <view class="moment-stats text-secondary">
            <view class="stat-item">
              <text class="stat-icon">❤️</text>
              <text class="stat-text">{{item.likeCount}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">💬</text>
              <text class="stat-text">{{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-icon">📝</view>
      <view class="empty-text text-secondary">
        TA还没有发布动态
      </view>
    </view>
  </view>
</view>
