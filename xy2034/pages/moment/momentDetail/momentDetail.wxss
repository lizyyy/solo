.login-section {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.login-content {
  display: flex;
  align-items: center;
}

.login-text {
  
}

.login-title {
  font-size: 26rpx;
  color: #666;
}

.login-btn {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.moment-section {
  margin-bottom: 30rpx;
}

.moment-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #e0e0e0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.privacy-tag {
  font-size: 20rpx;
  color: #999;
  background-color: #f0f0f0;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.moment-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: #333;
  margin-bottom: 24rpx;
}

.moment-actions {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

.action-icon.liked {
  opacity: 1;
}

.action-text {
  
}

.comments-section {
  margin-bottom: 120rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.comment-count {
  font-size: 24rpx;
}

.comments-list {
  
}

.comment-item {
  margin-bottom: 20rpx;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.commenter-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background-color: #e0e0e0;
}

.commenter-info {
  
}

.commenter-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 20rpx;
  margin-top: 2rpx;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
  padding-left: 76rpx;
}

.empty-comments {
  text-align: center;
  padding: 60rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 120rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.comment-input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.input-wrapper {
  
}

.comment-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #fafafa;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.comment-textarea:focus {
  border-color: #6B8DD6;
  background-color: #fff;
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999;
  margin-right: 30rpx;
  padding: 12rpx 24rpx;
}

.submit-btn {
  font-size: 28rpx;
  color: #fff;
  background-color: #6B8DD6;
  padding: 12rpx 36rpx;
  border-radius: 8rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.footer-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.btn-text {
  font-size: 30rpx;
  color: #6B8DD6;
  font-weight: 500;
}
