.user-section {
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #e0e0e0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.privacy-section {
  
}

.privacy-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.privacy-options {
  display: flex;
}

.privacy-option {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background-color: #f5f5f5;
  margin-right: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.privacy-option.selected {
  background-color: #e8f0fe;
  border-color: #6B8DD6;
}

.option-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.option-text {
  font-size: 26rpx;
  color: #666;
}

.privacy-option.selected .option-text {
  color: #6B8DD6;
  font-weight: 500;
}

.content-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #fafafa;
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.content-textarea:focus {
  border-color: #6B8DD6;
  background-color: #fff;
}

.word-count {
  text-align: right;
  margin-top: 12rpx;
}

.count-text {
  font-size: 24rpx;
  color: #6B8DD6;
}

.max-text {
  font-size: 24rpx;
}

.tips-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 120rpx;
  background-color: #e8f0fe;
  border-left: 6rpx solid #6B8DD6;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B8DD6;
  margin-bottom: 12rpx;
}

.tips-desc {
  
}

.tip-item {
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.footer-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.footer-section .btn-primary,
.footer-section .btn-secondary {
  width: 48%;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.footer-section .btn-primary.disabled {
  opacity: 0.6;
}
