.greeting-section {
  background: linear-gradient(135deg, #2c3e50 0%, #4a5568 100%);
  color: #fff;
  display: flex;
  align-items: center;
}

.greeting-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.greeting-text {
  flex: 1;
}

.greeting-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.greeting-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.category-section {
  margin: 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  padding: 0 20rpx;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background-color: #fff;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.category-active {
  background-color: #6B8DD6;
  color: #fff;
}

.push-list {
  padding-bottom: 40rpx;
}

.push-item {
  position: relative;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.push-item:active {
  transform: scale(0.99);
}

.push-type {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.daily-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.push-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.push-preview {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.push-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
}
