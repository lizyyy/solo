<view class="container">
  <!-- 画布区域 -->
  <view class="canvas-wrapper card">
    <canvas 
      class="doodle-canvas" 
      canvas-id="doodleCanvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; background-color: #ffffff;"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
    ></canvas>
    
    <!-- 画布提示 -->
    <view class="canvas-tip" wx:if="{{!showTools}}">
      <text class="tip-icon">✏️</text>
      <text class="tip-text">随手画画，释放情绪</text>
    </view>
  </view>

  <!-- 工具栏 -->
  <view class="tools-section {{showTools ? 'tools-expanded' : 'tools-collapsed'}}">
    <!-- 颜色选择 -->
    <view class="color-section" wx:if="{{showTools}}">
      <view class="section-label">画笔颜色</view>
      <view class="colors-row flex">
        <view 
          class="color-item {{currentColor === item.value && !isEraser ? 'color-active' : ''}}" 
          wx:for="{{colors}}" 
          wx:key="value"
          style="background-color: {{item.value}};"
          bindtap="selectColor"
          data-color="{{item.value}}"
        >
          <view class="color-check" wx:if="{{currentColor === item.value && !isEraser}}">✓</view>
        </view>
      </view>
    </view>

    <!-- 粗细选择 -->
    <view class="size-section" wx:if="{{showTools}}">
      <view class="section-label">画笔粗细</view>
      <view class="sizes-row flex">
        <view 
          class="size-item {{currentSize === item ? 'size-active' : ''}}" 
          wx:for="{{sizes}}" 
          wx:key="this"
          bindtap="selectSize"
          data-size="{{item}}"
        >
          <view class="size-dot" style="width: {{item * 2}}rpx; height: {{item * 2}}rpx;"></view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions-row flex flex-between">
      <view class="actions-left flex">
        <view 
          class="action-btn {{isEraser ? 'action-active' : ''}}" 
          bindtap="toggleEraser"
        >
          <text class="action-icon">🧽</text>
          <text class="action-text">橡皮擦</text>
        </view>
        <view class="action-btn" bindtap="undo">
          <text class="action-icon">↩️</text>
          <text class="action-text">撤销</text>
        </view>
        <view class="action-btn" bindtap="clearCanvas">
          <text class="action-icon">🗑️</text>
          <text class="action-text">清空</text>
        </view>
      </view>
      <view class="actions-right flex">
        <view class="action-btn" bindtap="saveDoodle">
          <text class="action-icon">💾</text>
          <text class="action-text">保存</text>
        </view>
        <view class="action-btn toggle-btn" bindtap="toggleTools">
          <text class="action-icon">{{showTools ? '▼' : '▲'}}</text>
          <text class="action-text">{{showTools ? '收起' : '展开'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip text-center text-secondary" wx:if="{{showTools}}">
    💡 提示：尽情涂鸦，释放你的情绪
  </view>
</view>
