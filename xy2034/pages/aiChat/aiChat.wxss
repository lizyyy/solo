.login-section {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.login-content {
  display: flex;
  align-items: center;
}

.login-text {
  
}

.login-title {
  font-size: 26rpx;
  color: #666;
}

.login-btn {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.messages-section {
  padding-bottom: 200rpx;
}

.message-item {
  margin-bottom: 24rpx;
}

.message-wrapper {
  display: flex;
  align-items: flex-start;
}

.ai-wrapper {
  justify-content: flex-start;
}

.user-wrapper {
  justify-content: flex-end;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-wrapper .message-avatar {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  margin-right: 16rpx;
}

.user-wrapper .message-avatar {
  background-color: #e0e0e0;
  margin-left: 16rpx;
}

.avatar-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.avatar-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.ai-bubble {
  background-color: #fff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user-bubble {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  border-bottom-right-radius: 8rpx;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.ai-bubble .message-content {
  color: #333;
}

.user-bubble .message-content {
  color: #fff;
}

.message-time {
  font-size: 20rpx;
  margin-top: 12rpx;
}

.ai-bubble .message-time {
  text-align: left;
}

.user-bubble .message-time {
  text-align: right;
  color: rgba(255, 255, 255, 0.7);
}

.typing-indicator {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.typing-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.typing-bubble {
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.typing-dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #6B8DD6;
  margin-right: 8rpx;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
  margin-right: 0;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.quick-replies-section {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.quick-replies-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.quick-replies-list {
  display: flex;
  flex-wrap: wrap;
}

.quick-reply-item {
  background-color: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #6B8DD6;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.quick-reply-item:active {
  background-color: #e8f0fe;
}

.input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.input-wrapper {
  flex: 1;
  margin-right: 16rpx;
}

.message-input {
  width: 100%;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  background-color: #fafafa;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.message-input:focus {
  border-color: #6B8DD6;
  background-color: #fff;
}

.send-btn {
  background: linear-gradient(135deg, #6B8DD6 0%, #8E9ACF 100%);
  color: #fff;
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn.disabled {
  opacity: 0.5;
}
