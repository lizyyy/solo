.intro-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  color: #fff;
}

.intro-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.intro-content {
  flex: 1;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.category-section {
  margin-bottom: 24rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.category-item.active {
  background-color: #6B8DD6;
  color: #fff;
  border-color: #6B8DD6;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.complaint-count {
  font-size: 24rpx;
}

.complaints-list {
  
}

.complaint-item {
  margin-bottom: 24rpx;
}

.complaint-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.complaint-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.complaint-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.complaint-footer {
  align-items: center;
}

.post-time {
  font-size: 22rpx;
}

.complaint-stats {
  display: flex;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.stat-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
  opacity: 0.6;
}

.stat-icon.liked {
  opacity: 1;
}

.stat-text {
  
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.create-complaint-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 36rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  z-index: 100;
}

.btn-icon {
  font-size: 36rpx;
  font-weight: 300;
  margin-right: 10rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}
