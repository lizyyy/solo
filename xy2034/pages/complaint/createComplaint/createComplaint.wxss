.input-section,
.category-section,
.content-section {
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.title-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background-color: #fafafa;
}

.title-input:focus {
  border-color: #6B8DD6;
  background-color: #fff;
}

.category-list {
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  background-color: #f5f7fa;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s ease;
}

.category-active {
  background-color: #6B8DD6;
  color: #fff;
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background-color: #fafafa;
}

.content-textarea:focus {
  border-color: #6B8DD6;
  background-color: #fff;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.submit-section {
  padding: 20rpx 0;
}

.submit-btn {
  width: 100%;
  background-color: #6B8DD6;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn:active {
  background-color: #5a7bc5;
}

.btn-disabled {
  background-color: #ccc;
}

.tips-section {
  padding: 30rpx 20rpx;
  font-size: 24rpx;
  color: #999;
}
