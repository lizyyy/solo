<view class="container" wx:if="{{complaint}}">
  <!-- 吐槽主体 -->
  <view class="complaint-card card">
    <!-- 分类标签 -->
    <view class="category-badge" style="background-color: {{complaint.category === '亲戚' ? '#fff3e0' : complaint.category === '学历焦虑' ? '#e3f2fd' : complaint.category === '家庭' ? '#fce4ec' : '#f5f5f5'}}; color: {{complaint.category === '亲戚' ? '#f57c00' : complaint.category === '学历焦虑' ? '#1976d2' : complaint.category === '家庭' ? '#c2185b' : '#666'}}">
      {{complaint.category}}
    </view>
    
    <!-- 标题 -->
    <view class="complaint-title">{{complaint.title}}</view>
    
    <!-- 作者信息 -->
    <view class="author-row flex align-center mt-20" bindtap="goToUserProfile" data-userid="{{complaint.userId}}">
      <image class="author-avatar" src="{{complaint.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=default%20avatar%20simple&image_size=square'}}" mode="aspectFill" />
      <view class="author-info flex-1 ml-20">
        <view class="author-name">{{complaint.userName}}</view>
        <view class="create-time text-secondary">{{complaint.createTime}}</view>
      </view>
    </view>
    
    <!-- 内容 -->
    <view class="complaint-content mt-30">
      {{complaint.content}}
    </view>
    
    <!-- 操作栏 -->
    <view class="action-row flex flex-between mt-40">
      <view class="action-item {{isLiked ? 'action-active' : ''}}" bindtap="toggleLike">
        <text class="action-icon">❤</text>
        <text class="action-text">{{complaint.likeCount}}</text>
      </view>
      <view class="action-item" bindtap="toggleCommentInput">
        <text class="action-icon">💬</text>
        <text class="action-text">{{complaint.commentCount}}</text>
      </view>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comments-section">
    <view class="section-header">
      <text class="section-title">全部评论 ({{complaint.comments ? complaint.comments.length : 0}})</text>
    </view>
    
    <view class="comments-list">
      <!-- 空状态 -->
      <view class="empty-comments text-center" wx:if="{{!complaint.comments || complaint.comments.length === 0}}">
        <view class="empty-icon">💭</view>
        <view class="empty-text text-secondary">暂无评论</view>
        <view class="empty-desc text-secondary">快来发表第一条评论吧</view>
      </view>
      
      <!-- 评论列表 -->
      <view class="comment-item card" wx:for="{{complaint.comments}}" wx:key="id">
        <view class="comment-header flex align-center" bindtap="goToUserProfile" data-userid="{{item.userId}}">
          <image class="comment-avatar" src="{{item.avatar || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=default%20avatar%20simple&image_size=square'}}" mode="aspectFill" />
          <view class="comment-user-info flex-1 ml-20">
            <view class="comment-user-name">{{item.userName}}</view>
            <view class="comment-time text-secondary">{{item.createTime}}</view>
          </view>
        </view>
        <view class="comment-content mt-20">
          {{item.content}}
        </view>
      </view>
    </view>
  </view>

  <!-- 底部评论输入 -->
  <view class="comment-input-section {{showCommentInput ? 'input-expanded' : ''}}">
    <view class="input-wrapper flex align-center">
      <view class="input-hint flex-1" wx:if="{{!showCommentInput}}" bindtap="toggleCommentInput">
        说点什么...
      </view>
      <view class="input-box flex-1" wx:if="{{showCommentInput}}">
        <input 
          class="comment-input" 
          placeholder="发表你的评论..." 
          value="{{commentContent}}"
          bindinput="onCommentInput"
          focus="{{showCommentInput}}"
        />
      </view>
      <button class="send-btn" bindtap="{{showCommentInput ? 'submitComment' : 'toggleCommentInput'}}" disabled="{{isSubmitting}}">
        {{showCommentInput ? '发送' : '评论'}}
      </button>
    </view>
  </view>

  <!-- 登录提示 -->
  <view class="login-prompt card" wx:if="{{!isLoggedIn}}">
    <view class="prompt-text">登录后可以点赞和评论哦~</view>
    <button class="login-btn" bindtap="handleLogin">立即登录</button>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container text-center" wx:if="{{!complaint}}">
  <text class="text-secondary">加载中...</text>
</view>
