.container {
  padding-bottom: 140rpx;
}

.complaint-card {
  margin-bottom: 20rpx;
}

.category-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.complaint-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.author-row {
  padding: 16rpx 0;
}

.author-avatar,
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.author-info {
  margin-left: 20rpx;
}

.author-name,
.comment-user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.create-time,
.comment-time {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mt-40 {
  margin-top: 40rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.align-center {
  align-items: center;
}

.complaint-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #444;
}

.action-row {
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background-color: #f5f7fa;
  transition: all 0.2s ease;
}

.action-item:active {
  background-color: #e8e8e8;
}

.action-active {
  background-color: #fee;
}

.action-active .action-icon {
  color: #ff6b6b;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.comments-section {
  margin-bottom: 20rpx;
}

.section-header {
  padding: 0 20rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.empty-comments {
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
}

.comment-item {
  margin: 0 20rpx 16rpx;
}

.comment-header {
  margin-bottom: 16rpx;
}

.comment-user-info {
  margin-left: 20rpx;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #444;
}

.comment-input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 16rpx 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  z-index: 100;
}

.input-expanded {
  padding-bottom: 40rpx;
}

.input-wrapper {
  align-items: center;
}

.input-hint {
  padding: 16rpx 24rpx;
  background-color: #f5f7fa;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
}

.input-box {
  margin-right: 16rpx;
}

.comment-input {
  width: 100%;
  padding: 16rpx 24rpx;
  background-color: #f5f7fa;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.send-btn {
  background-color: #6B8DD6;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin: 0;
}

.send-btn:active {
  background-color: #5a7bc5;
}

.send-btn[disabled] {
  background-color: #ccc;
}

.login-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx;
}

.prompt-text {
  font-size: 28rpx;
  color: #666;
}

.login-btn {
  background-color: #6B8DD6;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  margin: 0;
}

.loading-container {
  padding: 100rpx 0;
}
