.intro-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.intro-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.intro-content {
  flex: 1;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-section {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #333;
}

.progress-percent {
  font-size: 26rpx;
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6B8DD6 0%, #8E9ACF 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.question-nav {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.nav-item {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.nav-item.answered {
  background-color: #e8f0fe;
  color: #6B8DD6;
}

.nav-item.current {
  background-color: #6B8DD6;
  color: #fff;
}

.question-section {
  margin-bottom: 40rpx;
}

.question-number {
  font-size: 24rpx;
  color: #6B8DD6;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.question-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 30rpx;
}

.options-list {
  
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.option-item.selected {
  background-color: #e8f0fe;
  border-color: #6B8DD6;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.option-item.selected .option-radio {
  border-color: #6B8DD6;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #6B8DD6;
}

.option-label {
  font-size: 28rpx;
  color: #333;
}

.nav-buttons {
  display: flex;
  justify-content: space-between;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.nav-buttons .btn-primary,
.nav-buttons .btn-secondary {
  width: 48%;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.nav-buttons .btn-secondary.disabled {
  opacity: 0.5;
}

/* 结果页面样式 */
.result-section {
  padding-bottom: 40rpx;
}

.result-overview {
  text-align: center;
  margin-bottom: 30rpx;
}

.result-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.result-score {
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 28rpx;
  color: #666;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  margin: 0 8rpx;
}

.score-max {
  font-size: 28rpx;
  color: #999;
}

.result-level {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.level-info {
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.level-list {
  
}

.level-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.level-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.level-info {
  
}

.level-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.level-desc {
  font-size: 22rpx;
}

.suggestions-section {
  margin-bottom: 30rpx;
}

.suggestions-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.suggestions-list {
  
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.suggestion-icon {
  font-size: 28rpx;
  color: #6B8DD6;
  margin-right: 12rpx;
  font-weight: bold;
}

.suggestion-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.warning-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  background-color: #fff3cd;
  border-left: 6rpx solid #ffc107;
}

.warning-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.warning-content {
  flex: 1;
}

.warning-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #856404;
  margin-bottom: 8rpx;
}

.warning-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #856404;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
}

.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  width: 48%;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 12rpx;
}
