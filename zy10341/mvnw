#!/bin/sh
# Maven Wrapper 简化版
# 直接使用当前项目目录下的 .mvn/wrapper/maven-wrapper.jar

set -e

# 获取脚本所在目录的绝对路径
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Wrapper Jar 路径 - 直接使用当前项目下的 .mvn 目录
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"

# 检查 Jar 文件是否存在
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "错误: 找不到 Maven Wrapper Jar 文件"
    echo "期望路径: $WRAPPER_JAR"
    exit 1
fi

# 查找 Java
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# 执行 Maven Wrapper
exec "$JAVACMD" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$SCRIPT_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
