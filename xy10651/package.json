{
  "name": "cinema-cleaning-schedule",
  "version": "1.0.0",
  "description": "影院场务清洁排班系统",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "init-db": "node server/scripts/initDB.js",
    "init-data": "node server/scripts/initData.js",
    "setup": "npm install && cd client && npm install && cd .. && npm run init-db && npm run init-data",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
