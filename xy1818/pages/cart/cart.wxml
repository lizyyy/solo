<view class="page">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{empty && !loading}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车是空的</text>
    <text class="empty-desc">快去挑选喜欢的面包吧~</text>
    <view class="empty-btn btn btn-primary btn-lg" bindtap="onGoShopping">
      <text>去逛逛</text>
    </view>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{!empty && !loading}}">
    <view class="cart-item" wx:for="{{cart}}" wx:key="productId">
      <view class="item-checkbox {{item.selected ? 'checked' : ''}}" bindtap="onSelectItem" data-id="{{item.productId}}">
        <text wx:if="{{item.selected}}">✓</text>
      </view>
      <view class="item-image" bindtap="onProductTap" data-id="{{item.productId}}">
        <image src="{{item.product.image}}" mode="aspectFill" />
      </view>
      <view class="item-info">
        <view class="item-header" bindtap="onProductTap" data-id="{{item.productId}}">
          <text class="item-name">{{item.product.name}}</text>
          <text class="item-remove" catchtap="onRemoveItem" data-id="{{item.productId}}">×</text>
        </view>
        <view class="item-spec" wx:if="{{item.product.specifications && item.product.specifications.length > 0}}">
          <text class="spec-text">规格: {{item.product.specifications[0]}}</text>
        </view>
        <view class="item-bottom">
          <view class="item-price-row">
            <text class="item-price">{{item.product.price}}</text>
            <text class="item-original" wx:if="{{item.product.originalPrice > item.product.price}}">¥{{item.product.originalPrice}}</text>
          </view>
          <view class="item-quantity">
            <view class="quantity-btn {{item.quantity <= 1 ? 'disabled' : ''}}" catchtap="onQuantityChange" data-id="{{item.productId}}" data-type="decrease">
              <text>−</text>
            </view>
            <text class="quantity-text">{{item.quantity}}</text>
            <view class="quantity-btn" catchtap="onQuantityChange" data-id="{{item.productId}}" data-type="increase">
              <text>+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar" wx:if="{{!empty}}">
    <view class="bar-left">
      <view class="select-all {{selectAll ? 'checked' : ''}}" bindtap="onSelectAll">
        <text wx:if="{{selectAll}}">✓</text>
      </view>
      <text class="select-text">全选</text>
    </view>
    <view class="bar-right">
      <view class="total-info">
        <text class="total-label">合计:</text>
        <text class="total-price">{{totalAmount}}</text>
        <text class="total-count">(共{{totalCount}}件)</text>
      </view>
      <view class="checkout-btn {{totalCount > 0 ? '' : 'disabled'}}" bindtap="onCheckout">
        <text>去结算</text>
      </view>
    </view>
  </view>
</view>
