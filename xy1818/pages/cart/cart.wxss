.page {
  min-height: 100vh;
  background-color: #FFF5F5;
  padding-bottom: 140rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 24rpx 80rpx;
}

/* 购物车列表 */
.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.item-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-checkbox.checked {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  border-color: transparent;
}

.item-checkbox text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-remove {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.item-spec {
  margin-top: 8rpx;
}

.spec-text {
  font-size: 22rpx;
  color: #999999;
  background-color: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.item-price-row {
  display: flex;
  align-items: baseline;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #D32F2F;
}

.item-price::before {
  content: '¥';
  font-size: 0.8em;
}

.item-original {
  font-size: 22rpx;
  color: #999999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.item-quantity {
  display: flex;
  align-items: center;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn.disabled {
  opacity: 0.5;
}

.quantity-btn text {
  font-size: 36rpx;
  color: #333333;
  font-weight: 300;
}

.quantity-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  width: 80rpx;
  text-align: center;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: center;
}

.select-all {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.select-all.checked {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  border-color: transparent;
}

.select-all text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.select-text {
  font-size: 28rpx;
  color: #333333;
}

.bar-right {
  display: flex;
  align-items: center;
}

.total-info {
  display: flex;
  align-items: baseline;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 8rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #D32F2F;
}

.total-price::before {
  content: '¥';
  font-size: 0.7em;
}

.total-count {
  font-size: 22rpx;
  color: #999999;
  margin-left: 8rpx;
}

.checkout-btn {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.3);
}

.checkout-btn.disabled {
  opacity: 0.5;
}

.checkout-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
