.page {
  min-height: 100vh;
  background-color: #FFF5F5;
  padding-bottom: 140rpx;
}

/* 订单状态 */
.status-section {
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.status-info {
  display: flex;
  align-items: center;
}

.status-icon {
  font-size: 80rpx;
  margin-right: 24rpx;
}

.status-text {
  display: flex;
  flex-direction: column;
}

.status-name {
  font-size: 36rpx;
  font-weight: bold;
}

.status-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 通用区域样式 */
.section {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  padding: 24rpx 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  border-left: 6rpx solid #D32F2F;
  padding-left: 16rpx;
}

/* 收货地址 */
.address-info {
  padding: 10rpx 0;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.address-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}

.address-phone {
  font-size: 26rpx;
  color: #666666;
  margin-left: 20rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* 配送方式 */
.delivery-info {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.delivery-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.delivery-text {
  display: flex;
  flex-direction: column;
}

.delivery-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 商品列表 */
.product-list {
  padding: 10rpx 0;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  font-size: 28rpx;
  color: #D32F2F;
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 0.8em;
}

.product-quantity {
  font-size: 24rpx;
  color: #999999;
}

/* 订单信息 */
.info-list {
  padding: 10rpx 0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
}

/* 价格明细 */
.price-section {
  padding-bottom: 10rpx;
}

.price-list {
  padding: 10rpx 0;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: #666666;
}

.price-value {
  font-size: 26rpx;
  color: #333333;
}

.price-value::before {
  content: '¥';
  font-size: 0.8em;
}

.discount-item .price-value {
  color: #D32F2F;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #F5F5F5;
  margin-top: 10rpx;
}

.total-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.total-price {
  font-size: 40rpx;
  color: #D32F2F;
  font-weight: bold;
}

.total-price::before {
  content: '¥';
  font-size: 0.7em;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: center;
}

.bar-right {
  display: flex;
  align-items: center;
}

.action-btn {
  padding: 14rpx 36rpx;
  border-radius: 50rpx;
  margin-left: 16rpx;
}

.action-btn text {
  font-size: 26rpx;
}

.service {
  background-color: #F5F5F5;
}

.service text {
  color: #666666;
}

.cancel {
  background-color: #F5F5F5;
}

.cancel text {
  color: #666666;
}

.pay {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
}

.pay text {
  color: #FFFFFF;
}

.confirm {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
}

.confirm text {
  color: #FFFFFF;
}

.again {
  background-color: #FFEBEE;
}

.again text {
  color: #D32F2F;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: rotate 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
