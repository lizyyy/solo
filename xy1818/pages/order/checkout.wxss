.page {
  min-height: 100vh;
  background-color: #FFF5F5;
  padding-bottom: 140rpx;
}

/* 通用区域样式 */
.section {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  padding: 24rpx 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  border-left: 6rpx solid #D32F2F;
  padding-left: 16rpx;
}

/* 配送方式 */
.delivery-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.delivery-info {
  display: flex;
  align-items: center;
}

.delivery-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.delivery-text {
  display: flex;
  flex-direction: column;
}

.delivery-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.delivery-desc {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.delivery-arrow {
  font-size: 36rpx;
  color: #999999;
}

/* 收货地址 */
.address-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.address-info {
  flex: 1;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.address-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}

.address-phone {
  font-size: 26rpx;
  color: #666666;
  margin-left: 20rpx;
}

.address-detail {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.address-empty {
  flex: 1;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.address-arrow {
  font-size: 36rpx;
  color: #999999;
}

/* 商品列表 */
.product-list {
  padding: 10rpx 0;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  font-size: 28rpx;
  color: #D32F2F;
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 0.8em;
}

.product-quantity {
  font-size: 24rpx;
  color: #999999;
}

/* 优惠券 */
.coupon-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.coupon-info {
  display: flex;
  align-items: center;
}

.coupon-value {
  font-size: 32rpx;
  color: #D32F2F;
  font-weight: bold;
}

.coupon-name {
  font-size: 24rpx;
  color: #666666;
  margin-left: 16rpx;
}

.coupon-empty {
  display: flex;
  flex-direction: column;
}

.coupon-count {
  font-size: 20rpx;
  color: #D32F2F;
  margin-top: 4rpx;
}

.coupon-arrow {
  font-size: 36rpx;
  color: #999999;
}

/* 备注 */
.remark-section {
  padding: 10rpx 0;
}

.remark-input {
  width: 100%;
  height: 160rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 价格明细 */
.price-section {
  padding-bottom: 10rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: #666666;
}

.price-value {
  font-size: 26rpx;
  color: #333333;
}

.price-value::before {
  content: '¥';
  font-size: 0.8em;
}

.discount-item .price-value {
  color: #D32F2F;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: center;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
}

.total-price {
  font-size: 40rpx;
  color: #D32F2F;
  font-weight: bold;
  margin-left: 8rpx;
}

.total-price::before {
  content: '¥';
  font-size: 0.7em;
}

.bar-right {
  display: flex;
  align-items: center;
}

.submit-btn {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.3);
}

.submit-btn text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: rotate 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
