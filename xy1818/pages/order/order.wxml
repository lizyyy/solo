<view class="page">
  <!-- Tab 导航 -->
  <view class="tab-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="id" 
      class="tab-item {{activeTab === index ? 'active' : ''}}"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading && !empty}}">
    <view 
      wx:for="{{orders}}" 
      wx:key="id" 
      class="order-card"
      bindtap="onOrderTap"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
      </view>

      <!-- 订单商品 -->
      <view class="order-products">
        <view class="product-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="productId">
          <image class="product-image" src="{{product.product.image}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{product.product.name}}</text>
            <view class="product-bottom">
              <text class="product-price">{{product.product.price}}</text>
              <text class="product-quantity">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-info">
          <text class="order-time">{{item.createTimeText}}</text>
          <view class="order-amount">
            <text class="amount-label">共{{item.items.length}}件 实付:</text>
            <text class="amount-value">{{item.payAmount}}</text>
          </view>
        </view>
        <view class="order-actions" catchtap="">
          <!-- 待支付 -->
          <view wx:if="{{item.status === 'pending'}}">
            <view class="action-btn cancel" catchtap="onCancelOrder" data-id="{{item.id}}">
              <text>取消订单</text>
            </view>
            <view class="action-btn pay" catchtap="onPayOrder" data-id="{{item.id}}">
              <text>去支付</text>
            </view>
          </view>
          <!-- 已支付待收货 -->
          <view wx:elif="{{item.status === 'paid'}}">
            <view class="action-btn confirm" catchtap="onConfirmOrder" data-id="{{item.id}}">
              <text>确认收货</text>
            </view>
          </view>
          <!-- 已完成 -->
          <view wx:elif="{{item.status === 'completed'}}">
            <view class="action-btn again" catchtap="onGoShopping">
              <text>再来一单</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && empty}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <text class="empty-desc">快去挑选喜欢的面包吧~</text>
    <view class="empty-btn btn btn-primary btn-lg" bindtap="onGoShopping">
      <text>去逛逛</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-icon">⏳</text>
    <text class="loading-text">加载中...</text>
  </view>
</view>
