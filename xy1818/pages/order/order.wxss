.page {
  min-height: 100vh;
  background-color: #FFF5F5;
}

/* Tab 导航 */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #D32F2F;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

/* 订单商品 */
.order-products {
  padding: 20rpx 24rpx;
}

.product-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  font-size: 28rpx;
  color: #D32F2F;
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 0.8em;
}

.product-quantity {
  font-size: 24rpx;
  color: #999999;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 24rpx;
  border-top: 2rpx solid #F5F5F5;
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
}

.order-amount {
  display: flex;
  align-items: baseline;
}

.amount-label {
  font-size: 24rpx;
  color: #666666;
}

.amount-value {
  font-size: 32rpx;
  color: #D32F2F;
  font-weight: bold;
  margin-left: 8rpx;
}

.amount-value::before {
  content: '¥';
  font-size: 0.7em;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  margin-left: 16rpx;
}

.action-btn text {
  font-size: 24rpx;
}

.action-btn.cancel {
  background-color: #F5F5F5;
}

.action-btn.cancel text {
  color: #666666;
}

.action-btn.pay {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
}

.action-btn.pay text {
  color: #FFFFFF;
}

.action-btn.confirm {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
}

.action-btn.confirm text {
  color: #FFFFFF;
}

.action-btn.again {
  background-color: #FFEBEE;
}

.action-btn.again text {
  color: #D32F2F;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 24rpx 80rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: rotate 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
