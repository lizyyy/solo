<view class="page" wx:if="{{!loading && order}}">
  <!-- 订单状态 -->
  <view class="status-section" style="background: linear-gradient(135deg, {{order.statusColor}}40 0%, {{order.statusColor}}20 100%);">
    <view class="status-info">
      <text class="status-icon">{{order.status === 'pending' ? '⏳' : order.status === 'paid' ? '🚚' : order.status === 'completed' ? '✅' : '❌'}}</text>
      <view class="status-text">
        <text class="status-name" style="color: {{order.statusColor}}">{{order.statusText}}</text>
        <text class="status-time">{{order.createTimeText}}</text>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="section" wx:if="{{order.address}}">
    <view class="section-header">
      <text class="section-title">收货地址</text>
    </view>
    <view class="address-info">
      <view class="address-header">
        <text class="address-name">{{order.address.name}}</text>
        <text class="address-phone">{{order.address.phone}}</text>
      </view>
      <text class="address-detail">{{order.address.fullAddress}}</text>
    </view>
  </view>

  <!-- 配送方式 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">配送方式</text>
    </view>
    <view class="delivery-info">
      <text class="delivery-icon">{{order.deliveryMode === 'takeout' ? '🛵' : order.deliveryMode === 'pickup' ? '🏪' : '🍽️'}}</text>
      <view class="delivery-text">
        <text class="delivery-name">{{order.deliveryMode === 'takeout' ? '外卖' : order.deliveryMode === 'pickup' ? '自提' : '堂食'}}</text>
      </view>
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">商品清单</text>
    </view>
    <view class="product-list">
      <view class="product-item" wx:for="{{order.items}}" wx:key="productId">
        <image class="product-image" src="{{item.product.image}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.product.name}}</text>
          <view class="product-bottom">
            <text class="product-price">{{item.product.price}}</text>
            <text class="product-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">订单信息</text>
    </view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{order.createTimeText}}</text>
      </view>
      <view class="info-item" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="section price-section">
    <view class="section-header">
      <text class="section-title">价格明细</text>
    </view>
    <view class="price-list">
      <view class="price-item">
        <text class="price-label">商品金额</text>
        <text class="price-value">{{order.totalAmount}}</text>
      </view>
      <view class="price-item" wx:if="{{order.deliveryFee > 0}}">
        <text class="price-label">配送费</text>
        <text class="price-value">{{order.deliveryFee}}</text>
      </view>
      <view class="price-item" wx:if="{{order.packFee > 0}}">
        <text class="price-label">打包费</text>
        <text class="price-value">{{order.packFee}}</text>
      </view>
      <view class="price-item discount-item" wx:if="{{order.discountAmount > 0}}">
        <text class="price-label">优惠减免</text>
        <text class="price-value discount">-{{order.discountAmount}}</text>
      </view>
    </view>
    <view class="total-row">
      <text class="total-label">实付金额</text>
      <text class="total-price">{{order.payAmount}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{order.status !== 'cancelled' && order.status !== 'refunded'}}">
    <view class="bar-left">
      <view class="action-btn service" bindtap="onContactService">
        <text>联系客服</text>
      </view>
    </view>
    <view class="bar-right">
      <!-- 待支付 -->
      <view wx:if="{{order.status === 'pending'}}">
        <view class="action-btn cancel" bindtap="onCancelOrder">
          <text>取消订单</text>
        </view>
        <view class="action-btn pay" bindtap="onPayOrder">
          <text>去支付</text>
        </view>
      </view>
      <!-- 已支付待收货 -->
      <view wx:elif="{{order.status === 'paid'}}">
        <view class="action-btn confirm" bindtap="onConfirmOrder">
          <text>确认收货</text>
        </view>
      </view>
      <!-- 已完成 -->
      <view wx:elif="{{order.status === 'completed'}}">
        <view class="action-btn again" bindtap="onGoShopping">
          <text>再来一单</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-state" wx:if="{{loading}}">
  <text class="loading-icon">⏳</text>
  <text class="loading-text">加载中...</text>
</view>
