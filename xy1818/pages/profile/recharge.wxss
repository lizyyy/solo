.page {
  min-height: 100vh;
  background-color: #FFF5F5;
  padding-bottom: 140rpx;
}

.balance-section {
  margin: 20rpx 30rpx;
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 50%, #FFB3B3 100%);
}

.balance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.rule-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 8rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.balance-value {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.amount {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-left: 8rpx;
}

.member-level {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.level-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.level-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 215, 0, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.level-points {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
}

.recharge-section {
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.recharge-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recharge-item {
  width: 210rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #E0E0E0;
  position: relative;
  overflow: hidden;
}

.recharge-item.selected {
  border-color: #D32F2F;
  background-color: #FFF5F5;
}

.popular-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #FF9800 0%, #FFC107 100%);
  padding: 4rpx 16rpx;
  border-radius: 0 16rpx 0 16rpx;
}

.popular-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.recharge-amount {
  text-align: center;
}

.amount-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.recharge-bonus {
  text-align: center;
  margin-top: 8rpx;
}

.bonus-text {
  font-size: 22rpx;
  color: #D32F2F;
}

.check-icon {
  position: absolute;
  top: 0;
  left: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  border-radius: 0 0 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.custom-section {
  margin-top: 20rpx;
}

.custom-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.custom-input-wrap {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E0E0E0;
}

.custom-prefix {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-right: 8rpx;
}

.custom-input {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
}

.custom-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.pay-section {
  margin: 20rpx 30rpx;
}

.pay-methods {
  display: flex;
  flex-direction: column;
}

.pay-method {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.pay-method:last-child {
  border-bottom: none;
}

.pay-left {
  display: flex;
  align-items: center;
}

.pay-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.pay-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.pay-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-radio.checked {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  border-color: transparent;
}

.pay-radio text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.recharge-summary {
  background-color: #FFFFFF;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-row.total {
  padding-top: 16rpx;
  border-top: 2rpx solid #F5F5F5;
  margin-top: 16rpx;
  margin-bottom: 0;
}

.summary-label {
  font-size: 26rpx;
  color: #666666;
}

.summary-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.summary-value.bonus {
  color: #4CAF50;
}

.summary-value.total {
  font-size: 32rpx;
  color: #D32F2F;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-left {
  flex: 1;
}

.bottom-label {
  font-size: 24rpx;
  color: #999999;
}

.bottom-amount {
  font-size: 36rpx;
  color: #D32F2F;
  font-weight: bold;
}

.bottom-amount::before {
  content: '¥';
  font-size: 0.8em;
}

.recharge-btn {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.3);
}

.recharge-btn.disabled {
  background-color: #E0E0E0;
  color: #999999;
  box-shadow: none;
}
