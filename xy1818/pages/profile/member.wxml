<view class="page">
  <view class="member-header">
    <view class="header-bg"></view>
    <view class="member-card">
      <view class="card-left">
        <view class="member-avatar" wx:if="{{userInfo}}">
          <image class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        </view>
        <view class="member-avatar" wx:else>
          <text class="avatar-placeholder">😊</text>
        </view>
        <view class="member-info">
          <text class="member-name">{{userInfo ? userInfo.nickName : '未登录'}}</text>
          <view class="member-level-badge" style="background-color: {{memberInfo ? (memberLevels[getCurrentLevelIndex()].color) : '#999999'}}">
            <text class="level-icon">{{memberLevels[getCurrentLevelIndex()].icon}}</text>
            <text class="level-name">{{memberInfo ? memberInfo.levelName : '普通会员'}}</text>
          </view>
        </view>
      </view>
      <view class="card-right">
        <view class="recharge-btn" bindtap="onRechargeTap">
          <text class="btn-text">立即充值</text>
        </view>
      </view>
    </view>

    <view class="stats-section">
      <view class="stat-item">
        <text class="stat-value">{{memberInfo ? memberInfo.balance : '0.00'}}</text>
        <text class="stat-label">余额(元)</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{memberInfo ? memberInfo.points : 0}}</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{memberInfo ? memberInfo.totalRecharge : 0}}</text>
        <text class="stat-label">累计充值(元)</text>
      </view>
    </view>
  </view>

  <view class="progress-section card">
    <view class="progress-header">
      <text class="progress-title">会员升级进度</text>
      <text class="progress-info">{{memberInfo ? memberInfo.totalRecharge : 0}} / {{getNextLevel() ? getNextLevel().minAmount : '已达最高级'}}</text>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{getProgress().percent}}%"></view>
      </view>
      <text class="progress-percent">{{getProgress().percent}}%</text>
    </view>
    <view class="level-tips">
      <text class="tip-text">{{getNextLevel() ? '再充值' + (getNextLevel().minAmount - (memberInfo ? memberInfo.totalRecharge : 0)) + '元即可升级为' + getNextLevel().name : '您已是最高等级会员'}}</text>
    </view>
  </view>

  <view class="levels-section card">
    <view class="section-header">
      <text class="section-title">会员等级</text>
    </view>
    <view class="levels-list">
      <view 
        wx:for="{{memberLevels}}" 
        wx:key="level" 
        class="level-item {{getCurrentLevelIndex() === index ? 'active' : ''}} {{getCurrentLevelIndex() > index ? 'passed' : ''}}"
        bindtap="onLevelDetail"
        data-level="{{item.level}}"
      >
        <view class="level-icon-wrap" style="background-color: {{item.color}}20; border-color: {{item.color}}">
          <text class="level-icon-main">{{item.icon}}</text>
        </view>
        <view class="level-info">
          <text class="level-name-main">{{item.name}}</text>
          <text class="level-discount">{{item.discount}}</text>
          <text class="level-condition">累计充值满{{item.minAmount}}元</text>
        </view>
        <view class="level-status" wx:if="{{getCurrentLevelIndex() === index}}">
          <text class="status-text">当前</text>
        </view>
        <view class="level-status passed" wx:elif="{{getCurrentLevelIndex() > index}}">
          <text class="status-text">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view class="benefits-section card">
    <view class="section-header">
      <text class="section-title">当前权益</text>
    </view>
    <view class="benefits-grid">
      <view 
        wx:for="{{memberLevels[getCurrentLevelIndex()].benefits}}" 
        wx:key="*this" 
        class="benefit-item"
        bindtap="onBenefitTap"
        data-benefit="{{item}}"
      >
        <view class="benefit-icon-wrap">
          <text class="benefit-icon">🎁</text>
        </view>
        <text class="benefit-name">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="tips-section card">
    <view class="section-header">
      <text class="section-title">温馨提示</text>
    </view>
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-content">积分可用于抵扣订单金额，100积分=1元</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-content">每充值1元累计1积分，消费1元累计1积分</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-content">会员等级根据累计充值金额自动升级</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-content">余额和积分永久有效，不可提现</text>
      </view>
    </view>
  </view>
</view>
