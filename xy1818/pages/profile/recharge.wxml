<view class="page">
  <view class="balance-section card">
    <view class="balance-header">
      <text class="balance-label">当前余额</text>
      <text class="rule-link" bindtap="onRuleTap">充值规则</text>
    </view>
    <view class="balance-value">
      <text class="currency">¥</text>
      <text class="amount">{{memberInfo ? memberInfo.balance : '0.00'}}</text>
    </view>
    <view class="member-level" wx:if="{{memberInfo}}">
      <text class="level-icon">👑</text>
      <text class="level-name">{{memberInfo.levelName}}</text>
      <text class="level-points">积分：{{memberInfo.points}}</text>
    </view>
  </view>

  <view class="recharge-section">
    <view class="section-title">选择充值金额</view>
    <view class="recharge-options">
      <view 
        wx:for="{{rechargeOptions}}" 
        wx:key="amount" 
        class="recharge-item {{selectedOption && selectedOption.amount === item.amount ? 'selected' : ''}}"
        bindtap="onSelectOption"
        data-index="{{index}}"
      >
        <view class="popular-badge" wx:if="{{item.popular}}">
          <text class="popular-text">推荐</text>
        </view>
        <view class="recharge-amount">
          <text class="amount-text">¥{{item.amount}}</text>
        </view>
        <view class="recharge-bonus" wx:if="{{item.bonus > 0}}">
          <text class="bonus-text">送¥{{item.bonus}}</text>
        </view>
        <view class="check-icon" wx:if="{{selectedOption && selectedOption.amount === item.amount}}">
          <text class="check-text">✓</text>
        </view>
      </view>
    </view>

    <view class="custom-section">
      <view class="custom-label">自定义金额</view>
      <view class="custom-input-wrap">
        <text class="custom-prefix">¥</text>
        <input 
          class="custom-input" 
          type="digit" 
          placeholder="请输入金额" 
          value="{{customAmount}}"
          bindinput="onCustomAmountInput"
        />
      </view>
      <text class="custom-tip">最低充值10元</text>
    </view>
  </view>

  <view class="pay-section card">
    <view class="section-title">支付方式</view>
    <view class="pay-methods">
      <view 
        wx:for="{{payMethods}}" 
        wx:key="id" 
        class="pay-method {{item.selected ? 'selected' : ''}}"
        bindtap="onSelectPayMethod"
        data-id="{{item.id}}"
      >
        <view class="pay-left">
          <text class="pay-icon">{{item.icon}}</text>
          <text class="pay-name">{{item.name}}</text>
        </view>
        <view class="pay-radio {{item.selected ? 'checked' : ''}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view class="recharge-summary" wx:if="{{selectedOption || customAmount}}">
    <view class="summary-row">
      <text class="summary-label">充值金额</text>
      <text class="summary-value">¥{{selectedOption ? selectedOption.amount : customAmount}}</text>
    </view>
    <view class="summary-row" wx:if="{{selectedOption && selectedOption.bonus > 0}}">
      <text class="summary-label">赠送金额</text>
      <text class="summary-value bonus">+¥{{selectedOption.bonus}}</text>
    </view>
    <view class="summary-row total">
      <text class="summary-label">到账金额</text>
      <text class="summary-value total">
        ¥{{selectedOption ? (selectedOption.amount + selectedOption.bonus) : customAmount}}
      </text>
    </view>
  </view>

  <view class="bottom-bar safe-area-bottom">
    <view class="bottom-left">
      <text class="bottom-label">实付金额</text>
      <text class="bottom-amount">¥{{selectedOption ? selectedOption.amount : (customAmount || '0.00')}}</text>
    </view>
    <view class="bottom-right">
      <button 
        class="recharge-btn {{submitting ? 'disabled' : ''}}"
        bindtap="onRecharge"
        disabled="{{submitting}}"
      >
        {{submitting ? '充值中...' : '立即充值'}}
      </button>
    </view>
  </view>
</view>
