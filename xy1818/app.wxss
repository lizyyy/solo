page {
  background-color: #FFF5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-between {
  justify-content: space-between;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-align-center {
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: #D32F2F;
}

.text-secondary {
  color: #FF6B6B;
}

.text-warning {
  color: #FF9800;
}

.text-success {
  color: #4CAF50;
}

.text-muted {
  color: #999999;
}

.text-white {
  color: #FFFFFF;
}

.bg-primary {
  background-color: #D32F2F;
}

.bg-secondary {
  background-color: #FF6B6B;
}

.bg-white {
  background-color: #FFFFFF;
}

.bg-light {
  background-color: #FFF5F5;
}

.bg-pink {
  background-color: #FFEBEE;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #D32F2F 0%, #FF6B6B 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(211, 47, 47, 0.3);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid #D32F2F;
  color: #D32F2F;
}

.btn-outline:active {
  background-color: #FFEBEE;
}

.btn-block {
  width: 100%;
  box-sizing: border-box;
}

.btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.btn-lg {
  padding: 24rpx 60rpx;
  font-size: 32rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.divider {
  height: 2rpx;
  background-color: #F0F0F0;
  margin: 20rpx 0;
}

.price {
  color: #D32F2F;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 0.8em;
}

.price-original {
  color: #999999;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.badge-discount {
  background-color: #FF6B6B;
  color: #FFFFFF;
}

.badge-hot {
  background-color: #D32F2F;
  color: #FFFFFF;
}

.badge-new {
  background-color: #FF9800;
  color: #FFFFFF;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background-color: #FFEBEE;
  color: #D32F2F;
}

.tag-outline {
  border: 1rpx solid #E0E0E0;
  color: #666666;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-group label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input-group .input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.input-group .input:focus {
  border-color: #D32F2F;
  background-color: #FFFFFF;
}

.input-group textarea.input {
  height: 200rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .empty-text {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.empty-state .empty-desc {
  font-size: 24rpx;
  color: #CCCCCC;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page-padding {
  padding: 20rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.pt-20 {
  padding-top: 20rpx;
}

.pb-20 {
  padding-bottom: 20rpx;
}

.rounded {
  border-radius: 16rpx;
}

.rounded-sm {
  border-radius: 8rpx;
}

.rounded-lg {
  border-radius: 24rpx;
}

.shadow {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.border {
  border: 2rpx solid #F0F0F0;
}

.border-top {
  border-top: 2rpx solid #F0F0F0;
}

.border-bottom {
  border-bottom: 2rpx solid #F0F0F0;
}

.border-left {
  border-left: 2rpx solid #F0F0F0;
}

.border-right {
  border-right: 2rpx solid #F0F0F0;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.font-bold {
  font-weight: bold;
}

.font-medium {
  font-weight: 500;
}

.font-normal {
  font-weight: normal;
}

.text-xs {
  font-size: 20rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-base {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 44rpx;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

.sticky {
  position: sticky;
}

.top-0 {
  top: 0;
}

.bottom-0 {
  bottom: 0;
}

.left-0 {
  left: 0;
}

.right-0 {
  right: 0;
}

.z-10 {
  z-index: 10;
}

.z-20 {
  z-index: 20;
}

.z-30 {
  z-index: 30;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.min-h-screen {
  min-height: 100vh;
}
