  "confirmers": [
    {
      "user_id": "dev_lead_001",
      "user_name": "张三",
      "role": "开发负责人"
    },
    {
      "user_id": "test_lead_001",
      "user_name": "李四",
      "role": "测试负责人"
    },
    {
      "user_id": "product_001",
      "user_name": "王五",
      "role": "产品负责人"
    }
  ],

  "tolerance_rules": [
    {
      "name": "响应时间浮动 20%",
      "description": "允许响应时间有 20% 的浮动差异",
      "path_pattern": "response_time",
      "diff_type": "values_changed",
      "tolerance_type": "percentage",
      "tolerance_value": {
        "max_percent": 20
      },
      "is_active": true,
      "created_by": "admin"
    },
    {
      "name": "忽略时间戳字段",
      "description": "所有时间戳字段的差异自动容忍",
      "path_pattern": ".*(updated_at|created_at|timestamp).*",
      "diff_type": "values_changed",
      "tolerance_type": "always",
      "tolerance_value": null,
      "is_active": true,
      "created_by": "admin"
    },
    {
      "name": "数值范围容忍",
      "description": "数值在合理范围内的浮动",
      "path_pattern": ".*amount.*|.*total.*",
      "diff_type": "values_changed",
      "tolerance_type": "value_range",
      "tolerance_value": {
        "min": 0,
        "max": 1000
      },
      "is_active": true,
      "created_by": "admin"
    }
  ]
}
