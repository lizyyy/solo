{
  "name": "venue-ticket-api",
  "version": "1.0.0",
  "description": "场馆票务核销 API - 处理套票、转赠、退票、离线核销和重复入场",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "demo": "ts-node src/scripts/demo.ts",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "json2csv": "^6.0.0-alpha.2",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/uuid": "^9.0.0",
    "@types/cors": "^2.8.14",
    "@types/json2csv": "^5.0.7",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.2.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  }
}