#!/bin/sh
# Maven Wrapper - Simplified version for Java 8 compatibility

# Try to find Java
if [ -z "$JAVA_HOME" ]; then
    # Try to find java from PATH
    JAVA_CMD="$(command -v java 2>/dev/null || true)"
    if [ -z "$JAVA_CMD" ]; then
        echo "Error: java command not found in PATH" >&2
        echo "Please install Java 8 or higher and set JAVA_HOME" >&2
        exit 1
    fi
    # Try to find JAVA_HOME from java command path
    JAVA_HOME="$(dirname "$(dirname "$JAVA_CMD")")"
    echo "Detected JAVA_HOME: $JAVA_HOME"
else
    JAVA_CMD="$JAVA_HOME/bin/java"
fi

# Verify Java exists
if [ ! -x "$JAVA_CMD" ]; then
    echo "Error: Cannot find executable java at $JAVA_CMD" >&2
    exit 1
fi

# Get Java version
JAVA_VERSION="$("$JAVA_CMD" -version 2>&1 | head -n 1 | grep -Eo '"[0-9._]+"' | tr -d '"')"
echo "Java version: $JAVA_VERSION"

# Project directory
PRG_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PRG_DIR"

# Maven Wrapper properties
WRAPPER_JAR="$PRG_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$PRG_DIR/.mvn/wrapper/maven-wrapper.properties"

# Download wrapper jar if not exists
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Maven wrapper JAR not found, downloading..."
    
    # Try to get download URL from properties file
    if [ -f "$WRAPPER_PROPERTIES" ]; then
        DOWNLOAD_URL="$(grep '^wrapperUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2)"
    fi
    
    if [ -z "$DOWNLOAD_URL" ]; then
        DOWNLOAD_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.1.0/maven-wrapper-3.1.0.jar"
    fi
    
    # Create directory
    mkdir -p "$(dirname "$WRAPPER_JAR")"
    
    # Try to download with curl or wget
    if command -v curl > /dev/null 2>&1; then
        curl -f -L -o "$WRAPPER_JAR" "$DOWNLOAD_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget "$DOWNLOAD_URL" -O "$WRAPPER_JAR"
    else
        echo "Error: Neither curl nor wget is available" >&2
        echo "Please download $DOWNLOAD_URL" >&2
        echo "and place it at $WRAPPER_JAR" >&2
        exit 1
    fi
fi

# Run Maven Wrapper
echo "Running Maven with args: $*"
exec "$JAVA_CMD" \
    -classpath "$WRAPPER_JAR" \
    -Dmaven.multiModuleProjectDirectory="$PRG_DIR" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"