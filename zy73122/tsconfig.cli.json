{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "types": ["node"],
    "jsx": undefined,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/cli/**/*.ts", "src/utils/**/*.ts", "src/types/**/*.ts"]
}
