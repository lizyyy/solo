{
  "type": "object",
  "required": [
    "id",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{8}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped"
      ]
    }
  }
}