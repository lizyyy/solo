{
  "name": "jsonschema-sample-cli",
  "version": "1.0.0",
  "description": "JSON Schema样本生成CLI工具 - 生成正常、边界和非法样本用于联调测试",
  "main": "dist/cli.js",
  "bin": {
    "jsonschema-sample": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "selfcheck": "node dist/cli.js selfcheck",
    "generate": "node dist/cli.js generate"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "json-schema-faker": "^0.5.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
