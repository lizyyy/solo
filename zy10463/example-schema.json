{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "用户订单",
  "description": "电商系统中的用户订单数据结构",
  "type": "object",
  "required": ["orderId", "userId", "items", "status"],
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ORD-[0-9]{8}$",
      "description": "订单编号"
    },
    "userId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 50,
      "description": "用户ID"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "商品列表",
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "price"],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "price": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "paid", "shipped", "delivered", "cancelled"],
      "description": "订单状态"
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0.01
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "shippingAddress": {
      "type": "object",
      "properties": {
        "country": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "street": { "type": "string" },
        "zipCode": { "type": "string" }
      },
      "required": ["country", "city", "street", "zipCode"]
    }
  }
}
