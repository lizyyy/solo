#!/bin/sh
# Maven Wrapper 简化版
# 如果系统有 mvn 则直接使用，否则提示安装

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 检查系统是否有 mvn
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

# 如果没有 mvn，显示错误提示
echo "========================================"
echo "Maven Wrapper - Maven 未找到"
echo "========================================"
echo ""
echo "错误：系统未安装 Maven！"
echo ""
echo "请使用以下方式之一安装："
echo ""
echo "1) macOS (使用 Homebrew):"
echo "   brew install maven"
echo ""
echo "2) Ubuntu/Debian:"
echo "   sudo apt update"
echo "   sudo apt install maven"
echo ""
echo "3) CentOS/RHEL:"
echo "   sudo yum install maven"
echo ""
echo "4) Windows (使用 Chocolatey):"
echo "   choco install maven"
echo ""
echo "5) 手动下载:"
echo "   https://maven.apache.org/download.cgi"
echo ""
echo "安装后再次运行此脚本。"
echo ""
echo "或者使用项目启动脚本:"
echo "   ./start.sh build"
echo ""
exit 1
