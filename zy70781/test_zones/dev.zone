$ORIGIN example.com.
$TTL 600

@       IN  SOA     ns1.example.com. admin.example.com. (
            2024010101
            3600
            1800
            604800
            300
        )

@       IN  NS      ns1.example.com.
@       IN  NS      ns2.example.com.

@       IN  A       192.168.1.1
www     IN  A       192.168.1.2
api     IN  A       192.168.1.20
app     IN  A       192.168.1.4

db      IN  CNAME   database.example.com.
cache   IN  CNAME   local.redis.example.com.

mail    IN  MX  10  mail1.example.com.
mail    IN  MX  20  mail2.example.com.

dev     IN  A       172.16.0.1
local   IN  A       127.0.0.1
