# 消息重放审批服务配置文件
# 复制此文件为 .env 并根据需要修改

# 数据库配置
# SQLite: sqlite:///./mrs.db
# PostgreSQL: postgresql://user:password@host:port/dbname
# MySQL: mysql+pymysql://user:password@host:port/dbname
MRS_DATABASE_URL=sqlite:///./mrs.db

# 数据目录
MRS_DATA_DIR=./data

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
MRS_LOG_LEVEL=INFO

# 速率限制配置
MRS_DEFAULT_RATE_LIMIT_PER_SECOND=10
MRS_DEFAULT_RATE_LIMIT_PER_MINUTE=300
MRS_DEFAULT_RATE_LIMIT_PER_HOUR=10000

# 是否启用审批流程
MRS_ENABLE_APPROVAL=true

# 重试配置
MRS_MAX_RETRY_COUNT=3
MRS_RETRY_INTERVAL_SECONDS=60

# 试运行模式
MRS_DRY_RUN=false

# 消息中间件类型: mock, kafka, rabbitmq
MRS_BROKER_TYPE=mock

# Kafka 配置 (如果使用 Kafka)
# MRS_KAFKA_BROKERS=localhost:9092,localhost:9093

# RabbitMQ 配置 (如果使用 RabbitMQ)
# MRS_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
