PROJECT_NAME=贷款展期审批服务
API_V1_STR=/api/v1

# 数据库配置
# DATABASE_TYPE: sqlite 或 postgresql
# SQLite 为默认选项，无需外部服务，适合本地开发和验证
DATABASE_TYPE=sqlite

# SQLite 配置（默认）
SQLITE_DB_PATH=./loan_extension.db
# 设为 true 时使用内存数据库，适合快速验证
SQLITE_IN_MEMORY=false

# PostgreSQL 配置（可选，生产环境使用）
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_extension

# Redis 配置（后台任务使用，可选）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API 配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# 任务重试配置
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF=60
