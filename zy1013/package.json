{
  "name": "photo-listing-desk",
  "version": "1.0.0",
  "description": "二手闲置照片整理与上架管理工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox",
    "test": "node scripts/self-check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "photo",
    "listing",
    "second-hand",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sharp": "^0.33.2",
    "fs-extra": "^11.2.0",
    "csv-writer": "^1.6.0"
  },
  "build": {
    "appId": "com.photo-listing-desk",
    "productName": "Photo Listing Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ]
  }
}
