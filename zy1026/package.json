{
  "name": "docguard",
  "version": "1.0.0",
  "description": "文档发布巡检工具 - 检查 Markdown/MDX 中的图片、链接、锚点和外链",
  "main": "dist/index.js",
  "bin": {
    "docguard": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "markdown",
    "mdx",
    "documentation",
    "lint",
    "checker",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "marked": "^11.1.1",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/node-fetch": "^2.6.10",
    "@types/p-limit": "^2.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
