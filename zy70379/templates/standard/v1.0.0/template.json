{
  "version": "1.0.0",
  "name": "node-service-template",
  "type": "node",
  "description": "标准 Node 服务脚手架 v1.0.0",
  "packageJson": {
    "name": "@org/service",
    "scripts": {
      "start": "node dist/index.js",
      "build": "tsc",
      "dev": "ts-node-dev src/index.ts",
      "lint": "eslint src",
      "test": "jest",
      "healthcheck": "node scripts/healthcheck.js"
    },
    "engines": {
      "node": ">=18.0.0"
    },
    "dependencies": {
      "express": "^4.19.0",
      "winston": "^3.13.0",
      "dotenv": "^16.4.0"
    },
    "devDependencies": {
      "typescript": "^5.4.0",
      "jest": "^29.7.0",
      "eslint": "^8.57.0",
      "ts-node-dev": "^2.0.0"
    }
  },
  "dockerfile": {
    "baseImage": "node:18-alpine",
    "exposePort": 3000,
    "healthcheck": {
      "interval": "30s",
      "timeout": "10s",
      "retries": 3,
      "startPeriod": "40s"
    },
    "user": "node",
    "workdir": "/app"
  },
  "healthcheck": {
    "http": {
      "path": "/health",
      "method": "GET",
      "expectedStatus": 200
    }
  },
  "logging": {
    "format": "json",
    "level": "info",
    "destination": "stdout"
  },
  "directoryStructure": [
    "src/",
    "src/controllers/",
    "src/services/",
    "src/middlewares/",
    "src/utils/",
    "tests/",
    "scripts/",
    "config/"
  ],
  "requiredFiles": [
    "Dockerfile",
    "package.json",
    ".eslintrc.js",
    "tsconfig.json",
    "README.md"
  ]
}
