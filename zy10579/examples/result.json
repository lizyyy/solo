    {
      "step_type": "hudson.tasks.Shell",
      "raw_xml": "<hudson.tasks.Shell>\n  <command>#!/bin/bash\necho \"开始部署到 ${ENVIRONMENT} 环境\"\necho \"服务名称: ${SERVICE_NAME}\"\n\nif [ \"${FORCE_DEPLOY}\" = \"true\" ]; then\n  echo \"执行强制部署...\"\n  kubectl delete deployment ${SERVICE_NAME} -n ${ENVIRONMENT}\nfi\n\nif [ \"${CLEAN_OLD_DATA}\" = \"true\" ]; then\n  echo \"清理旧数据...\"\n  rm -rf /data/${SERVICE_NAME}/old/*\nfi\n\necho \"部署策略: ${DEPLOY_STRATEGY}\"</command>\n</hudson.tasks.Shell>\n",
