{
  "name": "remote-ops-approval-api",
  "version": "1.0.0",
  "description": "远程运维平台批量命令审批 API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "ts-node src/scripts/init-db.ts",
    "db:seed": "ts-node src/scripts/seed-data.ts",
    "test:acceptance": "ts-node src/scripts/acceptance-test.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "csv-writer": "^1.6.0",
    "csv-parser": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  }
}
