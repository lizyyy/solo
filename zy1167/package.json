{
  "name": "payroll-batch-service",
  "version": "1.0.0",
  "description": "批量发薪后端服务 - 支持分片处理、并发控制、幂等保障和重试机制",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "ts-node src/scripts/seed.ts"
  },
  "keywords": ["payroll", "batch", "concurrency", "idempotent"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "joi": "^17.12.1",
    "morgan": "^1.10.0",
    "pino": "^8.18.0",
    "pino-http": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}