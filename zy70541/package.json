{
  "name": "secret-lineage-api",
  "version": "1.0.0",
  "description": "Secret引用血缘API - 管理Secret引用关系、访问记录、替换计划和血缘报告",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node src/seed.ts",
    "init": "npm run prisma:generate && npm run prisma:migrate && npm run seed"
  },
  "keywords": ["secret", "lineage", "api", "security"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "express": "^4.18.2",
    "zod": "^3.22.0",
    "winston": "^3.11.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.0.0"
  }
}
