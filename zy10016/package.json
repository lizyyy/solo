{
  "name": "sqlite-wal-lock-system",
  "version": "1.0.0",
  "description": "SQLite WAL锁冲突处理系统 - 支持日志记录、状态追踪、错误回放、并发控制",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint src/**/*.ts",
    "stress": "ts-node scripts/stress-test.ts",
    "report": "ts-node scripts/generate-report.ts",
    "replay": "ts-node scripts/replay-error.ts"
  },
  "keywords": [
    "sqlite",
    "wal",
    "database-locking",
    "concurrency",
    "replay"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
