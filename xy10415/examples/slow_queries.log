2026-05-11 10:08:33|6.78|user_db|SELECT user_id, SUM(points) as total_points FROM user_points WHERE created_at >= '2026-01-01' GROUP BY user_id ORDER BY total_points DESC LIMIT 100;
2026-05-11 10:10:15|2.34|user_db|SELECT ua.* FROM user_addresses ua JOIN users u ON ua.user_id = u.id WHERE u.status = 'active';

