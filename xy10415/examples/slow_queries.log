# 数据库慢查询日志样例
# 格式: 时间 | 执行时间(秒) | 数据库 | SQL语句

# 订单服务相关查询
2026-05-11 09:15:30|5.23|order_db|SELECT * FROM orders WHERE user_id = 12345 AND status = 'paid' ORDER BY created_at DESC LIMIT 100;
2026-05-11 09:16:45|3.87|order_db|SELECT o.*, oi.* FROM orders o JOIN order_items oi ON o.id = oi.order_id WHERE o.created_at >= '2026-05-01' AND o.created_at < '2026-05-11';
2026-05-11 09:17:20|8.12|order_db|SELECT user_id, COUNT(*) as order_count, SUM(total_amount) as total FROM orders WHERE created_at BETWEEN '2026-04-01' AND '2026-05-01' GROUP BY user_id HAVING order_count > 10;

# 会员服务相关查询
