{
  "name": "css-token-contrast",
  "version": "1.0.0",
  "description": "CSS Token 对比度检查 CLI 工具 - 检查设计系统 token 组合的 WCAG 可访问性",
  "main": "dist/index.js",
  "bin": {
    "ctk-contrast": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "css",
    "design-tokens",
    "accessibility",
    "wcag",
    "contrast",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "json-source-map": "^0.6.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
