{
  "name": "warehouse-inventory-system",
  "version": "1.0.0",
  "description": "仓库盘点管理系统 - 支持离线操作、同步、日志、历史版本",
  "main": "electron/main.js",
  "scripts": {
    "build:services": "tsc --outDir dist/services src/services/*.ts src/utils/*.ts --module commonjs --target ES2020 --esModuleInterop --skipLibCheck",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && NODE_ENV=development electron .",
    "build": "npm run build:services && vite build && electron-builder",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed": "ts-node prisma/seed.ts",
    "migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma generate && npm run migrate && npm run seed"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@prisma/client": "^5.8.0",
    "antd": "^5.13.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.10",
    "electron-store": "^8.1.0",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  }
}
