generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum AuditOperation {
  CREATE
  UPDATE
  DELETE
  TRANSFER
  PRICE_CHANGE
  ADJUST
  REVERT
  BATCH
  EXPORT
}

enum AuditEntity {
  USER
  STORE
  PRODUCT
  INVENTORY
  INVENTORY_RECORD
  PRICE
  TRANSFER_ORDER
}

enum TransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REVERTED
  FAILED
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  RETRY
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  email     String?  @unique
  phone     String?
  role      UserRole @default(OPERATOR)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  auditLogs     AuditLog[]
  tasks         BackgroundTask[]
  transferOrders TransferOrder[]

  @@map("users")
  @@index([username])
  @@index([storeId])
}

model Store {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?
  phone       String?
  manager     String?
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               User[]
  inventories         Inventory[]
  sourceTransferOrders  TransferOrder[] @relation("SourceStore")
  targetTransferOrders  TransferOrder[] @relation("TargetStore")

  @@map("stores")
  @@index([code])
  @@index([name])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  barcode     String?  @unique
  category    String?
  unit        String
  spec        String?
  basePrice   Decimal  @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories     Inventory[]
  inventoryRecords InventoryRecord[]
  transferItems   TransferItem[]

  @@map("products")
  @@index([sku])
  @@index([barcode])
  @@index([name])
}

model Inventory {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int      @default(0)
  availableQty Int      @default(0)
  lockedQty    Int      @default(0)
  price        Decimal  @db.Decimal(12, 2)
  version      Int      @default(0)
  isActive     Boolean  @default(true)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryRecords InventoryRecord[]

  @@unique([storeId, productId])
  @@map("inventories")
  @@index([storeId])
  @@index([productId])
}

model InventoryRecord {
  id             String   @id @default(uuid())
  inventoryId    String
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
  storeId        String
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  operationType  String
  quantityBefore Int
  quantityAfter  Int
  changeQuantity Int
  priceBefore    Decimal? @db.Decimal(12, 2)
  priceAfter     Decimal? @db.Decimal(12, 2)
  referenceId    String?
  referenceType  String?
  operatorId     String
  operatorName   String
  remark         String?
  createdAt      DateTime @default(now())

  @@map("inventory_records")
  @@index([inventoryId])
  @@index([storeId, productId])
  @@index([createdAt])
  @@index([operatorId])
}

model TransferOrder {
  id                   String         @id @default(uuid())
  orderNo              String         @unique
  sourceStoreId        String
  sourceStore          Store          @relation("SourceStore", fields: [sourceStoreId], references: [id])
  targetStoreId        String
  targetStore          Store          @relation("TargetStore", fields: [targetStoreId], references: [id])
  status               TransferStatus @default(PENDING)
  totalQuantity        Int            @default(0)
  totalAmount          Decimal        @default(0) @db.Decimal(12, 2)
  operatorId           String?
  operator             User?          @relation(fields: [operatorId], references: [id])
  remark               String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  completedAt          DateTime?

  items TransferItem[]

  @@map("transfer_orders")
  @@index([orderNo])
  @@index([sourceStoreId])
  @@index([targetStoreId])
  @@index([status])
  @@index([createdAt])
}

model TransferItem {
  id              String   @id @default(uuid())
  transferOrderId String
  transferOrder   TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  price           Decimal  @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@unique([transferOrderId, productId])
  @@map("transfer_items")
  @@index([transferOrderId])
}

model AuditLog {
  id              String         @id @default(uuid())
  requestId       String?
  operation       AuditOperation
  entity          AuditEntity
  entityId        String?
  entityName      String?
  beforeSnapshot  Json?
  afterSnapshot   Json?
  changedFields   Json?
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  operatorName    String?
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime       @default(now())
  remark          String?
  parentLogId     String?
  parentLog       AuditLog?      @relation("ParentAuditLog", fields: [parentLogId], references: [id])
  childLogs       AuditLog[]     @relation("ParentAuditLog")

  @@map("audit_logs")
  @@index([requestId])
  @@index([operation])
  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
}

model BackgroundTask {
  id               String       @id @default(uuid())
  jobId            String?      @unique
  taskType         String
  name             String
  status           TaskStatus   @default(PENDING)
  priority         TaskPriority @default(NORMAL)
  payload          Json?
  result           Json?
  errorMessage     String?
  retryCount       Int          @default(0)
  maxRetryCount    Int          @default(3)
  dependsOnTaskId  String?
  sequenceNumber   Int?
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("background_tasks")
  @@index([jobId])
  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model IdempotentRequest {
  id         String   @id @default(uuid())
  requestId  String   @unique
  requestKey String   @unique
  status     String
  response   Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@map("idempotent_requests")
  @@index([requestId])
  @@index([requestKey])
  @@index([expiresAt])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
