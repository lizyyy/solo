// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TrackingPoint {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  description  String?
  page         String
  eventType    String
  required     Boolean  @default(true)
  version      String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pageEvents   PageEvent[]  @relation("TrackingPointEvents")
  missingDetections MissingDetection[] @relation("TrackingPointMissing")
}

model PageEvent {
  id           String   @id @default(uuid())
  trackingCode String
  sessionId    String
  pageUrl      String
  userId       String?
  properties   Json?
  userAgent    String?
  ip           String?
  timestamp    DateTime @default(now())
  retryCount   Int      @default(0)
  status       String   @default("received")
  idempotencyKey String  @unique
  createdAt    DateTime @default(now())

  trackingPoint TrackingPoint @relation("TrackingPointEvents", fields: [trackingCode], references: [code])
  session      DebugSession @relation("SessionEvents", fields: [sessionId], references: [sessionId])
}

model DebugSession {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  version      String
  operator     String?
  startTime    DateTime @default(now())
  endTime      DateTime?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  pageEvents   PageEvent[] @relation("SessionEvents")
  missingDetections MissingDetection[] @relation("SessionMissing")
}

model MissingDetection {
  id           String   @id @default(uuid())
  sessionId    String
  trackingCode String
  expectedTime DateTime
  detectedAt   DateTime @default(now())
  status       String   @default("pending")
  reason       String?
  resolution   String?
  resolvedBy   String?
  resolvedAt   DateTime?
  correctionPath Json?

  session      DebugSession @relation("SessionMissing", fields: [sessionId], references: [sessionId])
  trackingPoint TrackingPoint @relation("TrackingPointMissing", fields: [trackingCode], references: [code])
  reviewLogs   ReviewLog[]
}

model ReviewLog {
  id           String   @id @default(uuid())
  detectionId  String
  action       String
  reason       String
  operator     String?
  createdAt    DateTime @default(now())

  detection    MissingDetection @relation(fields: [detectionId], references: [id])
}

model VersionRelease {
  id           String   @id @default(uuid())
  version      String   @unique
  description  String?
  status       String   @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewReason String?
  createdAt    DateTime @default(now())
}
