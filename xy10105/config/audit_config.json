{
  "sensor_id_column": "sensor_id",
  "timestamp_column": "timestamp",
  "temperature_column": "temperature",
  "humidity_column": "humidity",
  "location_column": "location",
  "batch_column": "batch_id",
  
  "temperature_valid_units": ["C", "c", "°C", "摄氏度", "℃", "F", "f", "°F", "华氏度"],
  "humidity_valid_units": ["%", "%RH", "RH", "相对湿度"],
  "default_temperature_unit": "C",
  "default_humidity_unit": "%RH",
  
  "temperature_range": [-40.0, 85.0],
  "humidity_range": [0.0, 100.0],
  
  "temperature_delta_threshold": 2.0,
  "humidity_delta_threshold": 5.0,
  
  "iqr_multiplier": 1.5,
  "z_score_threshold": 3.0,
  
  "duplicate_check_columns": ["sensor_id", "timestamp"],
  
  "timestamp_format": null,
  "timezone": null,
  
  "drift_window_size": 30,
  "drift_threshold_temp": 1.5,
  "drift_threshold_humidity": 3.0,
  
  "calibration_reference_sensor": null,
  "calibration_method": "linear",
  
  "report_output_dir": "reports",
  "data_output_dir": "output",
  
  "export_excel": true,
  "export_html": true
}
