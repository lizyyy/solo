#!/bin/sh
# Maven Wrapper 启动脚本
# 如果系统没有安装 Maven，此脚本会提示使用备选方案

echo "=============================================="
echo "  Maven Wrapper"
echo "=============================================="
echo ""

# 检查 maven-wrapper.jar 是否存在
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"

if [ -f "$WRAPPER_JAR" ]; then
    # 如果有 wrapper jar，使用它
    if command -v java >/dev/null 2>&1; then
        exec java -jar "$WRAPPER_JAR" "$@"
    else
        echo "错误: 未找到 Java 命令"
        echo "请安装 Java 8 或更高版本"
        exit 1
    fi
fi

# 检查系统是否有 mvn
if command -v mvn >/dev/null 2>&1; then
    echo "使用系统 Maven: $(mvn -v | head -n 1)"
    echo ""
    exec mvn "$@"
fi

# 如果都没有，提供备选方案
echo ""
echo "✗ 未找到 Maven Wrapper JAR 文件，系统也未安装 Maven"
echo ""
echo "=============================================="
echo "  备选方案（推荐）：使用纯 Shell 脚本"
echo "=============================================="
echo ""
echo "方式 1: 构建项目（下载依赖+编译）"
echo "  ./build.sh"
echo ""
echo "方式 2: 启动服务（构建成功后）"
echo "  ./start.sh"
echo ""
echo "方式 3: 验证接口（服务启动后）"
echo "  ./verify.sh"
echo ""
echo "如需使用 Maven，请安装 Maven 后重试，或下载:"
echo "  https://repo.maven.apache.org/maven2/io/takari/maven-wrapper/0.5.6/maven-wrapper-0.5.6.jar"
echo "  保存到: .mvn/wrapper/maven-wrapper.jar"
echo ""

exit 1
