    "dotenv": "^16.3.1",
    "body-parser": "^1.20.2",
    "express-validator": "^7.0.1",
    "dayjs": "^1.11.10",
    "xlsx": "^0.18.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
