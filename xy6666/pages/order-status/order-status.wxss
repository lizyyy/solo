/* 订单状态页样式 */
page {
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 状态头部 */
.status-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.status-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 60rpx;
}

.status-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.status-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 进度步骤 */
.progress-section {
  margin: 20rpx;
  padding: 30rpx;
}

.progress-steps {
  display: flex;
  flex-direction: column;
}

.step-item {
  display: flex;
  position: relative;
  margin-bottom: 40rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F0F0F0;
  transition: all 0.3s ease;
}

.step-item.completed .step-circle,
.step-item.active .step-circle {
  background-color: #FF6B35;
}

.step-icon {
  font-size: 32rpx;
}

.step-line {
  width: 4rpx;
  height: 60rpx;
  background-color: #F0F0F0;
  margin-top: 10rpx;
  transition: all 0.3s ease;
}

.step-item.completed .step-line {
  background-color: #FF6B35;
}

.step-content {
  flex: 1;
  padding-top: 8rpx;
}

.step-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #999999;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.step-item.completed .step-name,
.step-item.active .step-name {
  color: #333333;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 订单详情 */
.order-detail-section {
  margin: 20rpx;
  padding: 30rpx;
}

.section-header-order {
  margin-bottom: 24rpx;
}

.section-title-order {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 订单信息 */
.order-info {
  margin-bottom: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.divider-order {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 24rpx 0;
}

/* 商品列表 */
.order-items {
  margin-bottom: 10rpx;
}

.order-item {
  display: flex;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F8F8F8;
}

.order-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.item-image-wrap-order {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.item-image-order {
  width: 100%;
  height: 100%;
}

.item-info-order {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name-row-order {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.item-name-order {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.item-quantity-order {
  font-size: 26rpx;
  color: #999999;
}

.item-specs-order {
  margin-bottom: 8rpx;
}

.spec-text-order {
  font-size: 24rpx;
  color: #999999;
}

.item-toppings-order {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.toppings-label-order {
  font-size: 24rpx;
  color: #999999;
}

.toppings-text-order {
  font-size: 24rpx;
  color: #666666;
}

.item-price-row-order {
  display: flex;
  align-items: baseline;
}

.price-symbol-order {
  font-size: 22rpx;
  color: #FF6B35;
  font-weight: 500;
}

.price-amount-order {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
}

/* 订单金额 */
.order-total-section {
  margin-top: 10rpx;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.total-row:last-child {
  margin-bottom: 0;
}

.total-row.final {
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.total-label-order {
  font-size: 26rpx;
  color: #666666;
}

.total-value-order {
  font-size: 26rpx;
  color: #333333;
}

.total-value-final {
  display: flex;
  align-items: baseline;
}

.total-symbol-order {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 500;
}

.total-amount-order {
  font-size: 36rpx;
  color: #FF6B35;
  font-weight: 600;
}

/* 取餐提示 */
.pickup-tip {
  margin: 20rpx;
  padding: 24rpx 30rpx;
  background-color: #FFF8E5;
  border: 1rpx solid #FFE58F;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #D48806;
}

.tip-content {
  display: flex;
  flex-direction: column;
}

.tip-text {
  font-size: 26rpx;
  color: #D48806;
  margin-bottom: 8rpx;
}

.tip-text:last-child {
  margin-bottom: 0;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons-order {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 50rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn.secondary {
  background-color: #F5F5F5;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 53, 0.3);
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.secondary .action-btn-text {
  color: #666666;
}

.action-btn.primary .action-btn-text {
  color: #FFFFFF;
}

/* 空状态 */
.empty-order {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon-order {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text-order {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 40rpx;
}

.go-index-btn-order {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 53, 0.3);
}

.go-index-text-order {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}
