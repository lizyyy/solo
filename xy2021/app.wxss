page {
  background-color: #E8F5E9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
  font-size: 28rpx;
  color: #333333;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background-color: #4CAF50;
  margin-right: 12rpx;
  border-radius: 3rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 50rpx;
  padding: 18rpx 38rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-disabled {
  background-color: #CCCCCC;
  color: #999999;
}

.text-primary {
  color: #4CAF50;
}

.text-secondary {
  color: #666666;
}

.text-light {
  color: #999999;
}

.text-danger {
  color: #F44336;
}

.text-warning {
  color: #FF9800;
}

.text-success {
  color: #4CAF50;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-around {
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.p-24 {
  padding: 24rpx;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: bold;
}

.border-bottom {
  border-bottom: 1rpx solid #EEEEEE;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F8E9 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid rgba(76, 175, 80, 0.2);
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.progress-bar {
  height: 12rpx;
  background-color: #E8F5E9;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #81C784 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.icon-green {
  background-color: #E8F5E9;
  color: #4CAF50;
}

.icon-orange {
  background-color: #FFF3E0;
  color: #FF9800;
}

.icon-blue {
  background-color: #E3F2FD;
  color: #2196F3;
}

.icon-red {
  background-color: #FFEBEE;
  color: #F44336;
}
