.header-card {
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  color: #FFFFFF;
}

.avatar-box {
  width: 96rpx;
  height: 96rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
}

.level {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.points-box {
  text-align: right;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.points-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.points-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.checkin-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.streak-text {
  font-size: 26rpx;
  opacity: 0.9;
}

.streak-number {
  font-size: 36rpx;
  color: #FFD700;
  margin: 0 8rpx;
}

.btn-primary {
  background: rgba(255, 255, 255, 0.3);
  border: none;
  box-shadow: none;
  font-weight: bold;
}

.btn-primary.btn-disabled {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.7);
}

.week-days {
  margin-top: 24rpx;
}

.day-item {
  text-align: center;
  flex: 1;
  padding: 12rpx 0;
  border-radius: 12rpx;
}

.day-item.today {
  background-color: rgba(255, 255, 255, 0.3);
}

.day-name {
  font-size: 22rpx;
  opacity: 0.8;
}

.day-date {
  font-size: 28rpx;
  margin-top: 4rpx;
  color: #FFFFFF;
}

.air-content {
  align-items: center;
}

.air-city {
  font-size: 28rpx;
  color: #666666;
}

.air-level {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

.aqi-value {
  font-size: 48rpx;
  font-weight: bold;
}

.aqi-label {
  font-size: 22rpx;
  color: #999999;
  margin-left: 8rpx;
}

.tasks-list {
  margin-top: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.6;
}

.task-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.task-title {
  font-size: 30rpx;
  color: #333333;
}

.task-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.task-right {
  text-align: right;
}

.task-points {
  font-size: 28rpx;
  font-weight: bold;
}

.task-status {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.task-status.done {
  color: #4CAF50;
}

.more-btn {
  font-size: 24rpx;
  margin-left: auto;
  font-weight: normal;
}

.features-grid {
  margin-top: 24rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.feature-name {
  font-size: 24rpx;
  color: #666666;
  margin-top: 12rpx;
}

.history-list {
  margin-top: 16rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-reason {
  font-size: 28rpx;
  color: #333333;
}

.history-date {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.history-points {
  font-size: 30rpx;
  font-weight: bold;
}

.view-more {
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  width: 80%;
  max-width: 600rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-header {
  position: relative;
}

.close-btn {
  position: absolute;
  top: -20rpx;
  right: -10rpx;
  font-size: 48rpx;
  color: #999999;
}

.checkin-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.checkin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.checkin-message {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.checkin-streak {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.checkin-bonus {
  font-size: 24rpx;
  color: #FF9800;
}

.text-small {
  font-size: 24rpx;
}

.air-card, .footprint-card, .tasks-card, .features-card, .history-card {
  margin-top: 24rpx;
}
