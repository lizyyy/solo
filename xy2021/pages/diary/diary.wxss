.earth-status-card, .tab-card, .message-card, .quote-card, .write-card, .diaries-card, .empty-card, .wish-card, .wishes-card, .game-card {
  margin-top: 24rpx;
}

.earth-status-card {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 50%, #81C784 100%);
  color: #FFFFFF;
  text-align: center;
}

.earth-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.earth-title {
  font-size: 28rpx;
  font-weight: 500;
  opacity: 0.9;
}

.earth-stats {
  margin-top: 16rpx;
  gap: 16rpx;
}

.earth-stats .stat-item {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
}

.earth-stats .stat-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.earth-stats .stat-label {
  font-size: 20rpx;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tab-card {
  padding: 16rpx 24rpx;
}

.tabs {
  background-color: #F5F5F5;
  border-radius: 50rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #FFFFFF;
  color: #4CAF50;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.tab-content {
  margin-top: 24rpx;
}

.message-header {
  align-items: center;
}

.message-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.message-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.message-content {
  line-height: 1.8;
}

.quote-header {
  align-items: center;
}

.quote-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.refresh-btn {
  font-size: 24rpx;
}

.quote-content {
  background-color: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.quote-text {
  font-size: 28rpx;
  color: #2E7D32;
  line-height: 1.8;
  font-style: italic;
}

.write-card, .wish-card {
  border: 2rpx dashed #4CAF50;
  background-color: #FAFFFA;
}

.write-content, .wish-content {
  padding: 32rpx;
}

.write-icon, .wish-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.write-text, .wish-text {
  font-size: 30rpx;
  font-weight: 500;
}

.write-bonus, .wish-bonus {
  margin-top: 4rpx;
}

.diary-list {
  margin-top: 16rpx;
}

.diary-item {
  padding: 20rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.diary-item:last-child {
  margin-bottom: 0;
}

.diary-header {
  align-items: center;
}

.diary-left {
  align-items: center;
}

.diary-mood {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.diary-date {
  font-size: 24rpx;
}

.diary-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.empty-state {
  padding: 48rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
}

.empty-hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.wish-list {
  margin-top: 16rpx;
}

.wish-item {
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFEFD5 100%);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.wish-item:last-child {
  margin-bottom: 0;
}

.wish-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.wish-footer {
  align-items: center;
  margin-top: 12rpx;
}

.wish-date {
  font-size: 22rpx;
}

.wish-actions {
  align-items: center;
}

.like-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.like-count {
  font-size: 22rpx;
}

.game-header {
  align-items: center;
}

.game-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.score-label {
  font-size: 24rpx;
}

.score-value {
  font-size: 28rpx;
}

.game-description {
  line-height: 1.6;
}

.game-area {
  position: relative;
  min-height: 400rpx;
}

.game-grid {
  gap: 16rpx;
}

.trash-item {
  padding: 24rpx 16rpx;
  background-color: #FFF3E0;
  border-radius: 16rpx;
  border: 2rpx solid #FFB74D;
}

.trash-icon {
  font-size: 48rpx;
}

.trash-name {
  margin-top: 4rpx;
}

.healing-effects {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.heal-effect {
  position: absolute;
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: bold;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.game-empty {
  padding: 48rpx;
}

.game-tips {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-bullet {
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.tip-text {
  flex: 1;
  line-height: 1.6;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  width: 85%;
  max-width: 650rpx;
  max-height: 80vh;
  padding: 32rpx;
  overflow-y: auto;
}

.modal-header {
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.close-btn {
  font-size: 48rpx;
  color: #999999;
}

.mood-section {
  margin-top: 16rpx;
}

.section-title {
  margin-bottom: 12rpx;
}

.mood-list {
  justify-content: space-around;
}

.mood-item {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.mood-item.active {
  background-color: #E8F5E9;
  border-color: #4CAF50;
}

.mood-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mood-name {
  text-align: center;
}

.content-section, .wish-input-section {
  margin-top: 24rpx;
}

.diary-textarea, .wish-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.char-count {
  margin-top: 8rpx;
}

.wish-tips {
  margin-top: 16rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-actions .btn-primary,
.modal-actions .btn-secondary {
  flex: 1;
  margin: 0;
}

.text-small {
  font-size: 24rpx;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.mt-4 {
  margin-top: 4rpx;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-12 {
  margin-top: 12rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mb-12 {
  margin-bottom: 12rpx;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.animate-bounce {
  animation: bounce 2s ease-in-out infinite;
}

@keyframes heal {
  0% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  100% {
    opacity: 0;
    transform: scale(1.2) translateY(-40rpx);
  }
}

.animate-heal {
  animation: heal 1s ease-out forwards;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}
