#!/bin/bash
# Maven Wrapper with Docker fallback
# Uses Docker if local Maven not available

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Method 1: Try local Maven first
if command -v mvn >/dev/null 2>&1; then
    cd "$SCRIPT_DIR" && mvn "$@"
    exit $?
fi

# Method 2: Use Docker to run Maven
if command -v docker >/dev/null 2>&1; then
    if ! docker info >/dev/null 2>&1; then
        echo "[ERROR] Docker daemon is not running!"
        echo "Please start Docker Desktop first"
        exit 1
    fi
    
    echo "[INFO] Using Docker Maven..."
    docker run -it --rm \
        -v "$SCRIPT_DIR:/app" \
        -v "$HOME/.m2:/root/.m2" \
        -w /app \
        maven:3.8.6-openjdk-11 \
        mvn "$@"
    exit $?
fi

echo "[ERROR] Neither Maven nor Docker found!"
echo "Please install one of:"
echo "  - Maven: brew install maven or https://maven.apache.org/download.cgi"
echo "  - Docker: https://docs.docker.com/get-docker/"
exit 1
