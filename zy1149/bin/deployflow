#!/usr/bin/env php
<?php

declare(strict_types=1);

if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} else {
    echo "Error: Vendor autoload not found. Please run 'composer install' first.\n";
    exit(1);
}

use Symfony\Component\Console\Application;
use DeployFlow\Command\InitCommand;
use DeployFlow\Command\ValidateCommand;
use DeployFlow\Command\BuildCommand;
use DeployFlow\Command\PlanCommand;
use DeployFlow\Command\ReleaseCommand;
use DeployFlow\Command\RollbackCommand;
use DeployFlow\Command\ReportCommand;

$application = new Application('DeployFlow', '1.0.0');

$application->add(new InitCommand());
$application->add(new ValidateCommand());
$application->add(new BuildCommand());
$application->add(new PlanCommand());
$application->add(new ReleaseCommand());
$application->add(new RollbackCommand());
$application->add(new ReportCommand());

$application->run();
