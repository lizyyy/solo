{
    "name": "deployflow/deployflow",
    "description": "PHP 项目打包发布流程管理工具",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "symfony/console": "^6.0",
        "symfony/yaml": "^6.0",
        "symfony/filesystem": "^6.0",
        "symfony/finder": "^6.0",
        "symfony/process": "^6.0",
        "league/flysystem": "^3.0",
        "nette/neon": "^3.0",
        "ext-json": "*",
        "ext-zip": "*",
        "ext-pcre": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "symfony/var-dumper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "DeployFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeployFlow\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/deployflow"
    ],
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
