{
  "name": "tool-sharing-service",
  "version": "1.0.0",
  "description": "共享工具借还预约服务",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node scripts/seed.js",
    "init-db": "node scripts/init-db.js",
    "test": "jest --verbose",
    "test:conflict": "jest tests/test.conflict.js --verbose",
    "test:waitlist": "jest tests/test.waitlist.js --verbose",
    "test:overdue": "jest tests/test.overdue.js --verbose",
    "test:dispute": "jest tests/test.dispute.js --verbose"
  },
  "keywords": [
    "tool-sharing",
    "reservation",
    "api",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "sequelize": "^6.35.2",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/test.*.js"
    ]
  }
}
