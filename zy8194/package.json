{
  "name": "rag-retrieval-checker",
  "version": "1.0.0",
  "description": "RAG 检索回归预检 CLI 工具",
  "main": "dist/index.js",
  "bin": {
    "rag-check": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "demo": "npm run build && node dist/index.js --chunks sample/knowledge_chunks.jsonl --queries sample/queries.csv --expected sample/expected_refs.yaml --rules sample/eval_rules.yaml --output ./reports"
  },
  "keywords": ["rag", "retrieval", "evaluation", "cli", "typescript"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "csv-parse": "^5.5.2",
    "csv-stringify": "^6.4.4",
    "js-yaml": "^4.1.0",
    "ml-distance": "^4.0.1",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.3.2"
  }
}
