{
  "name": "connection-pool-monitor",
  "version": "1.0.0",
  "description": "数据库连接池监控系统 - 支持并发控制、异常恢复、幂等性、缓存一致性和错误回放",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "benchmark": "ts-node benchmarks/connection-pool.bench.ts",
    "stress": "ts-node stress-tests/stress-test.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "generic-pool": "^3.9.0",
    "winston": "^3.11.0",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1",
    "eventemitter3": "^5.0.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.1"
  },
  "optionalDependencies": {
    "pg": "^8.11.3",
    "mysql2": "^3.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "@types/compression": "^1.7.5",
    "@types/pg": "^8.10.9",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "autocannon": "^7.15.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
