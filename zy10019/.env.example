PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DB_TYPE=mock
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test
DB_USER=test
DB_PASSWORD=test
DB_VALIDATION_QUERY=SELECT 1

POOL_NAME=default-pool
POOL_MIN=2
POOL_MAX=10
POOL_ACQUIRE_TIMEOUT=30000
POOL_IDLE_TIMEOUT=60000
POOL_REAP_INTERVAL=30000
POOL_TEST_ON_BORROW=true
POOL_TEST_ON_RETURN=false
POOL_TEST_WHILE_IDLE=true

CACHE_STRATEGY=read-through
ENABLE_CACHE=true
ENABLE_EVENTS=true
ENABLE_CIRCUIT_BREAKER=true
ENABLE_RETRY=true
ENABLE_IDEMPOTENCY=true

REPLAY_MAX_RECORDS=10000
REPLAY_RETENTION=86400000
REPLAY_PATH=./data/events
REPLAY_AUTO_PERSIST=true
