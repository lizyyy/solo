#!/bin/sh
# Maven Wrapper script
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
M2_HOME="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
java -classpath "$M2_HOME/maven-wrapper.jar" "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
