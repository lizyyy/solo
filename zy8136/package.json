{
  "name": "canary-replay-cli",
  "version": "1.0.0",
  "description": "TypeScript CLI for offline replay of gateway canary policies",
  "main": "dist/index.js",
  "bin": {
    "canary-replay": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "replay": "npm run dev -- replay",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "keywords": [
