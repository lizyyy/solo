# 应用配置
APP_NAME=设备能效基线管理系统
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///./energy_efficiency.db
# DATABASE_URL=postgresql://user:password@localhost:5432/energy_efficiency
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/energy_efficiency

# Redis/Celery配置
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 任务配置
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=60

# 数据分析配置
OUTLIER_THRESHOLD=3.0
MIN_DATA_POINTS=10

# 导出配置
EXPORT_DIR=./exports
