{
  "name": "climbing-route-reviewer",
  "version": "1.0.0",
  "description": "室内攀岩馆线路定线复盘器",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch\" \"npm run start\"",
    "build": "tsc && npm run copy-assets",
    "watch": "tsc -w",
    "copy-assets": "mkdir -p dist/renderer && cp -r src/renderer/* dist/renderer/ 2>/dev/null || true",
    "test": "npx ts-node test-services.ts"
  },
  "keywords": [
    "climbing",
    "route",
    "reviewer",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.39",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "electron-is-dev": "^3.0.1"
  }
}
