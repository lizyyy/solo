{
  "name": "chatbot-interception-system",
  "version": "1.0.0",
  "description": "聊天机器人越权拦截知识库管理系统",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && (cd backend && npm install) && (cd frontend && npm install)",
    "seed": "cd backend && npx ts-node src/seed.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "selfcheck:run": "curl -X POST http://localhost:3001/api/self-check/run",
    "export:run": "curl -o export_test.xlsx http://localhost:3001/api/export",
    "verify": "node scripts/verify-prod.cjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
