{
  "name": "sourcemap-leak-checker",
  "version": "1.0.0",
  "description": "Sourcemap 泄漏检查 CLI 工具 - 扫描前端产物中的 sourcemap 安全问题",
  "bin": {
    "smcheck": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/cli/index.js",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "sourcemap",
    "security",
    "cli",
    "scanner",
    "leak"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "glob": "^10.3.10",
    "source-map": "^0.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/source-map": "^0.5.7",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
