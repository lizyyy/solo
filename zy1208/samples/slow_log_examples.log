-- ============================================
-- PostgreSQL 慢查询日志示例
-- 包含多种问题 SQL 模式
-- ============================================

-- 问题 1: 慢查询 - 全表扫描
LOG:  duration: 12500.234 ms  statement: SELECT * FROM users WHERE email = 'test@example.com';

-- 问题 2: 无 LIMIT 的 SELECT
LOG:  duration: 8500.123 ms  statement: SELECT * FROM orders WHERE status = 'pending';

-- 问题 3: SELECT *
LOG:  duration: 5200.456 ms  statement: SELECT * FROM products WHERE category_id = 10;

-- 问题 4: 前置通配符 LIKE
LOG:  duration: 3800.789 ms  statement: SELECT * FROM users WHERE username LIKE '%admin%';

-- 问题 5: ORDER BY 无索引
LOG:  duration: 6100.321 ms  statement: SELECT * FROM orders ORDER BY created_at DESC;

-- 问题 6: 大量行扫描
LOG:  duration: 9200.654 ms  execute <unnamed>: SELECT * FROM logs WHERE created_at > '2024-01-01';

-- 问题 7: 长事务
LOG:  duration: 45000.000 ms  statement: BEGIN;
LOG:  duration: 1000.000 ms  statement: UPDATE user_points SET available_points = available_points - 100 WHERE user_id = 12345;
LOG:  duration: 30000.000 ms  statement: SELECT pg_sleep(30);
LOG:  duration: 500.000 ms  statement: COMMIT;

-- 问题 8: SELECT ... FOR UPDATE (读写混合)
LOG:  duration: 1500.000 ms  statement: SELECT * FROM user_points WHERE user_id = 12345 FOR UPDATE;

-- 问题 9: 未使用绑定变量
LOG:  duration: 800.000 ms  statement: SELECT * FROM users WHERE id = 1;
LOG:  duration: 800.000 ms  statement: SELECT * FROM users WHERE id = 2;
LOG:  duration: 800.000 ms  statement: SELECT * FROM users WHERE id = 3;

-- 问题 10: 函数索引列导致索引失效
LOG:  duration: 2500.000 ms  statement: SELECT * FROM orders WHERE DATE(created_at) = '2024-01-15';

-- 问题 11: OR 条件导致索引失效
LOG:  duration: 3200.000 ms  statement: SELECT * FROM orders WHERE status = 'pending' OR status = 'processing';

-- 问题 12: 隐式类型转换
LOG:  duration: 1800.000 ms  statement: SELECT * FROM orders WHERE order_no = 12345;

-- 问题 13: 大表 JOIN 无索引
LOG:  duration: 15000.000 ms  statement: 
    SELECT o.*, oi.* 
    FROM orders o 
    JOIN order_items oi ON o.id = oi.order_id 
    WHERE o.created_at > '2024-01-01';

-- 问题 14: 单条 INSERT 过多
LOG:  duration: 100.000 ms  statement: INSERT INTO logs (user_id, action, created_at) VALUES (1, 'login', NOW());
LOG:  duration: 100.000 ms  statement: INSERT INTO logs (user_id, action, created_at) VALUES (1, 'view', NOW());
LOG:  duration: 100.000 ms  statement: INSERT INTO logs (user_id, action, created_at) VALUES (1, 'click', NOW());
LOG:  duration: 100.000 ms  statement: INSERT INTO logs (user_id, action, created_at) VALUES (1, 'scroll', NOW());
LOG:  duration: 100.000 ms  statement: INSERT INTO logs (user_id, action, created_at) VALUES (1, 'logout', NOW());

-- 问题 15: 热点更新 (频繁更新同一行)
LOG:  duration: 200.000 ms  statement: UPDATE user_points SET available_points = available_points + 10 WHERE user_id = 99999;
LOG:  duration: 250.000 ms  statement: UPDATE user_points SET available_points = available_points + 10 WHERE user_id = 99999;
LOG:  duration: 300.000 ms  statement: UPDATE user_points SET available_points = available_points + 10 WHERE user_id = 99999;
LOG:  duration: 280.000 ms  statement: UPDATE user_points SET available_points = available_points + 10 WHERE user_id = 99999;
LOG:  duration: 320.000 ms  statement: UPDATE user_points SET available_points = available_points + 10 WHERE user_id = 99999;
