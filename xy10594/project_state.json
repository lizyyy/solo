  "subtitles": [
    {
      "id": "sub-001",
      "start_time": 5.0,
      "end_time": 8.0,
      "text": "欢迎大家来到我的直播间"
    },
    {
      "id": "sub-002",
      "start_time": 10.0,
      "end_time": 14.0,
      "text": "今天给大家带来我们家的明星产品"
    },
    {
      "id": "sub-003",
      "start_time": 185.0,
      "end_time": 190.0,
      "text": "首先我们来做洁面，这款洗面奶非常温和"
    },
    {
      "id": "sub-004",
      "start_time": 195.0,
      "end_time": 200.0,
      "text": "大家可以看到它的泡沫非常细腻"
    },
    {
      "id": "sub-005",
      "start_time": 210.0,
      "end_time": 215.0,
      "text": "接下来是爽肤水，轻轻拍打吸收"
    },
    {
      "id": "sub-006",
      "start_time": 250.0,
      "end_time": 255.0,
      "text": "这款精华液含有玻尿酸成分"
    },
    {
      "id": "sub-007",
      "start_time": 320.0,
      "end_time": 325.0,
      "text": "保湿效果非常好，适合秋冬季节"
    },
    {
      "id": "sub-008",
      "start_time": 620.0,
      "end_time": 625.0,
      "text": "现在我们来画底妆，先涂隔离"
    },
    {
      "id": "sub-009",
      "start_time": 650.0,
      "end_time": 655.0,
      "text": "这款粉底液的遮瑕力中等偏上"
    },
    {
      "id": "sub-010",
      "start_time": 700.0,
      "end_time": 705.0,
      "text": "绝对保证正品，大家可以放心购买"
    },
    {
      "id": "sub-011",
      "start_time": 920.0,
      "end_time": 925.0,
      "text": "现在是限时抢购环节，价格非常优惠"
    },
    {
      "id": "sub-012",
      "start_time": 950.0,
      "end_time": 955.0,
      "text": "买一送一，只限今天直播间"
    },
    {
      "id": "sub-013",
      "start_time": 980.0,
      "end_time": 985.0,
      "text": "最后五分钟，倒计时开始"
    },
    {
      "id": "sub-014",
      "start_time": 1250.0,
      "end_time": 1255.0,
      "text": "敏感肌可以使用这款产品吗"
    },
    {
      "id": "sub-015",
      "start_time": 1260.0,
      "end_time": 1265.0,
      "text": "敏感肌也是可以的，我们的成分很温和"
    }
  ],
