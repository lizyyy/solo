PORT=3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=live_push

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=live-push-service
KAFKA_GROUP_ID=live-push-consumer-group
KAFKA_TOPIC=live-push-messages
KAFKA_PARTITIONS=16

CACHE_TTL=300
CACHE_NAMESPACE=live_push

LOCK_TTL=10000
LOCK_TIMEOUT=5000

IDEMPOTENCY_TTL=86400

RETRY_MAX_RETRIES=5
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=30000

LOG_LEVEL=info
