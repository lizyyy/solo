{
  "name": "light-checker",
  "version": "1.0.0",
  "description": "灯光巡演预检工具 - 扫描并校验灯光控台导出的文件",
  "main": "dist/cli.js",
  "bin": {
    "light-checker": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "nodemon --watch src --exec ts-node src/cli.ts",
    "server": "node dist/server.js",
    "dev-server": "nodemon --watch src --exec ts-node src/server.ts"
  },
  "keywords": ["lighting", "dmx", "cue", "checker", "theater"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chalk": "^2.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
