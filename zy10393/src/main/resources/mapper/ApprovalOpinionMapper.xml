<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.datarepair.approval.mapper.ApprovalOpinionMapper">

    <select id="selectByScriptId" resultType="com.datarepair.approval.entity.ApprovalOpinion">
        SELECT * FROM approval_opinion
        WHERE script_id = #{scriptId}
        AND deleted = 0
        ORDER BY create_time DESC
    </select>

</mapper>
