<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.datarepair.approval.mapper.TimelineRecordMapper">

    <select id="selectByScriptId" resultType="com.datarepair.approval.entity.TimelineRecord">
        SELECT * FROM timeline_record
        WHERE script_id = #{scriptId}
        AND deleted = 0
        ORDER BY action_time DESC
    </select>

    <select id="selectByScriptIdOrderByTime" resultType="com.datarepair.approval.entity.TimelineRecord">
        SELECT * FROM timeline_record
        WHERE script_id = #{scriptId}
        AND deleted = 0
        ORDER BY action_time ASC
    </select>

</mapper>
