{
  "name": "ad-budget-api",
  "version": "1.0.0",
  "description": "广告预算消耗 API - 支持预算池管理、素材绑定、渠道扣费、补量回滚、超支拦截和消耗报表",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch"
  },
  "keywords": [
    "ad-budget",
    "budget-management",
    "advertising"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.1",
    "@types/uuid": "^9.0.1",
    "csv-writer": "^1.6.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5"
  }
}
