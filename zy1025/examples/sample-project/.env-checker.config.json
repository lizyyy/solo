{
  "optionalVars": [
    "DEBUG",
    "LOG_LEVEL",
    "API",
    "REDIS_URL",
    "BUILD_ENV",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD"
  ],
  "localOnlyVars": [
    "DEV_TOOLS",
    "HOT_RELOAD",
    "USER_EMAIL"
  ],
  "excludedFiles": [
    "// 要排除的文件/目录模式（支持 glob 风格）",
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**"
  ],
  "envFilePatterns": [
    "// 要扫描的 env 文件模式",
    ".env",
    ".env.example",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test"
  ],
  "scanMarkdown": true,
  "scanDockerCompose": true,
  "scanPackageJson": true,
  "redactSecrets": true
}