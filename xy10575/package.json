    "@types/node": "^20.5.0",
    "@types/uuid": "^9.0.2",
    "@types/cors": "^2.8.13",
    "@types/json2csv": "^5.0.3",
    "@types/jest": "^29.5.3",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1"
  }
