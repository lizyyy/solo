{
  "name": "course-replay-auth-system",
  "version": "1.0.0",
  "description": "课程直播回放授权管理系统",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "init-data": "node server/scripts/initData.js",
    "demo": "node server/scripts/demo.js",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": ["course", "replay", "authorization", "management"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "moment": "^2.29.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
