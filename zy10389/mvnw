#!/bin/bash
# Maven Wrapper - 最终修复版
# 核心修复：使用 -cp + 主类方式运行，不依赖 jar 的 Manifest

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"
WRAPPER_MAIN="org.apache.maven.wrapper.MavenWrapperMain"

# 优先使用系统 Maven
if command -v mvn >/dev/null 2>&1; then
    echo -e "${GREEN}使用系统 Maven${NC}" >&2
    exec mvn "$@"
fi

# 有预编译 jar 且是 run 命令，直接启动
if [ "$1" = "spring-boot:run" ] || [ "$1" = "run" ]; then
    if [ -f "target/api-tag-validation-1.0.0.jar" ]; then
        echo -e "${GREEN}发现预编译 jar 包，直接启动...${NC}" >&2
        exec java -jar target/api-tag-validation-1.0.0.jar
    fi
fi

# 检查 Java
if ! command -v java >/dev/null 2>&1; then
    echo -e "${RED}错误: 未找到 Java，请先安装 JDK 17+${NC}" >&2
    exit 1
fi

# 检查 wrapper jar 是否存在且有效
download_wrapper() {
    echo -e "${YELLOW}下载 Maven Wrapper...${NC}" >&2
    mkdir -p "$(dirname "$WRAPPER_JAR")"
    
    local url="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
    
    # 尝试下载
    if command -v curl >/dev/null 2>&1; then
        if ! curl -f -L -sS --connect-timeout 10 --max-time 120 -o "$WRAPPER_JAR" "$url"; then
            return 1
        fi
    elif command -v wget >/dev/null 2>&1; then
        if ! wget -q --timeout=120 -O "$WRAPPER_JAR" "$url"; then
            return 1
        fi
    else
        echo -e "${RED}错误: 未找到 curl 或 wget${NC}" >&2
        return 1
    fi
    return 0
}

# 验证 wrapper jar 是否可用
validate_wrapper() {
    if [ ! -f "$WRAPPER_JAR" ]; then
        return 1
    fi
    # 验证 jar 文件大小（合理的 wrapper jar 应该大于 50KB）
    local size=$(stat -f%z "$WRAPPER_JAR" 2>/dev/null || stat -c%s "$WRAPPER_JAR" 2>/dev/null || echo 0)
    if [ "$size" -lt 50000 ]; then
        return 1
    fi
    # 尝试用 Java 验证主类是否存在
    if ! java -cp "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain --version >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

# 确保 wrapper 可用
if ! validate_wrapper; then
    if ! download_wrapper; then
        echo "" >&2
        echo -e "${RED}========================================${NC}" >&2
        echo -e "${RED}  Maven Wrapper 不可用${NC}" >&2
        echo -e "${RED}========================================${NC}" >&2
        echo "" >&2
        echo "可用替代方案（按优先级）：" >&2
        echo "" >&2
        echo "  🚀 1. 使用一键启动脚本: ./quick-start.sh" >&2
        echo "     自动检测环境并选择最佳启动方式" >&2
        echo "" >&2
        echo "  📦 2. 安装系统 Maven:" >&2
        echo "     macOS:  brew install maven" >&2
        echo "     Linux:  sudo apt install maven" >&2
        echo "" >&2
        echo "  💻 3. 使用 IDE 直接运行主类:" >&2
        echo "     com.observability.tagvalidation.TagValidationApplication" >&2
        echo "" >&2
        echo "  📥 4. 手动下载 Maven Wrapper:" >&2
        echo "     mkdir -p .mvn/wrapper" >&2
        echo "     curl -o .mvn/wrapper/maven-wrapper.jar \\" >&2
        echo "       https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar" >&2
        exit 1
    fi
    echo -e "${GREEN}✓ Maven Wrapper 下载完成${NC}" >&2
fi

# 关键修复：使用 -cp classpath + 主类方式运行，不依赖 jar 的 Manifest
echo -e "${BLUE}使用 Maven Wrapper 运行...${NC}" >&2
exec java \
    -cp "$WRAPPER_JAR" \
    -Dmaven.multiModuleProjectDirectory="$SCRIPT_DIR" \
    "$WRAPPER_MAIN" \
    "$@"
