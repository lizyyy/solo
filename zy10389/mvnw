#!/bin/sh
# Maven Wrapper - 简化但可靠版本

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 首先检查系统 Maven
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

# 检查是否有预编译 jar
if [ "$1" = "spring-boot:run" ] || [ "$1" = "run" ]; then
    if [ -f "target/api-tag-validation-1.0.0.jar" ]; then
        echo -e "${GREEN}发现预编译 jar 包，直接启动...${NC}" >&2
        exec java -jar target/api-tag-validation-1.0.0.jar
    fi
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"

# 检查 jar 是否存在
if [ ! -f "$WRAPPER_JAR" ]; then
    echo -e "${YELLOW}未找到 Maven Wrapper，尝试下载...${NC}" >&2
    echo -e "${YELLOW}如遇网络问题，请使用: ./quick-start.sh 查看其他方案${NC}" >&2
    echo "" >&2
    
    mkdir -p "$(dirname "$WRAPPER_JAR")"
    
    # 尝试下载
    download_success=false
    if command -v curl >/dev/null 2>&1; then
        if curl -f -L -sS --connect-timeout 10 --max-time 60 \
            -o "$WRAPPER_JAR" \
            "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"; then
            download_success=true
        fi
    elif command -v wget >/dev/null 2>&1; then
        if wget -q --timeout=60 -O "$WRAPPER_JAR" \
            "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"; then
            download_success=true
        fi
    fi
    
    if [ "$download_success" = false ]; then
        echo "" >&2
        echo -e "${RED}========================================${NC}" >&2
        echo -e "${RED}  Maven Wrapper 下载失败${NC}" >&2
        echo -e "${RED}========================================${NC}" >&2
        echo "" >&2
        echo "可用替代方案：" >&2
        echo "" >&2
        echo "  1. 使用一键启动脚本: ./quick-start.sh" >&2
        echo "  2. 手动下载: https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar" >&2
        echo "     保存到: .mvn/wrapper/maven-wrapper.jar" >&2
        echo "  3. 安装系统 Maven: brew install maven 或 sudo apt install maven" >&2
        echo "  4. 使用 IDE 直接运行主类: com.observability.tagvalidation.TagValidationApplication" >&2
        exit 1
    fi
fi

# 检查 Java
if ! command -v java >/dev/null 2>&1; then
    echo -e "${RED}错误: 未找到 Java，请先安装 JDK 17+${NC}" >&2
    exit 1
fi

# 正确运行 Maven Wrapper
exec java \
    -Dmaven.multiModuleProjectDirectory="$SCRIPT_DIR" \
    -jar "$WRAPPER_JAR" "$@"
