.dashboard-page {
  min-height: 100vh;
  background: #f8f9fa;
}

.header-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
}

.header-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tabs {
  display: flex;
  background: #fff;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #999;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  font-weight: 500;
}

.tab-content {
  padding: 20rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.stat-info {
  flex: 1;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-warning {
  font-size: 20rpx;
  color: #dc3545;
  margin-top: 2rpx;
}

.big-stat-card {
  text-align: center;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border-radius: 16rpx;
}

.big-stat-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.big-stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #667eea;
  margin-bottom: 10rpx;
}

.big-stat-hint {
  font-size: 22rpx;
  color: #999;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.stat-name {
  font-size: 24rpx;
  color: #999;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.quick-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.quick-text {
  font-size: 22rpx;
  color: #666;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-row {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  text-align: center;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.summary-value.highlight {
  color: #667eea;
}

.list-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.list-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.purchase-list,
.session-list {
  padding: 0 24rpx;
}

.purchase-item,
.session-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.purchase-item:last-child,
.session-item:last-child {
  border-bottom: none;
}

.purchase-left,
.session-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.purchase-type,
.session-type {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.purchase-info,
.session-info {
  flex: 1;
}

.purchase-name,
.session-project {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.purchase-detail,
.session-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.dot {
  width: 6rpx;
  height: 6rpx;
  background: #ccc;
  border-radius: 50%;
}

.purchase-amount,
.session-duration {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}
