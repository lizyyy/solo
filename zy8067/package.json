{
  "name": "plugin-validator-cli",
  "version": "1.0.0",
  "description": "Offline CLI for validating low-code platform plugins",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plugin-validator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "demo": "npm run build && node dist/cli.js ./example-plugin",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "vm2": "^3.9.19"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}