{
  "name": "node-matrix-cli",
  "version": "1.0.0",
  "description": "Node版本矩阵检测工具 - 检测多包Node版本要求冲突，生成本地与CI兼容的版本矩阵报告",
  "main": "dist/index.js",
  "bin": {
    "node-matrix": "./bin/node-matrix.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "node",
    "version",
    "matrix",
    "cli",
    "engines",
    "ci"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "semver": "^7.6.0",
    "js-yaml": "^4.1.0",
    "table": "^6.8.2",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/semver": "^7.5.6",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
