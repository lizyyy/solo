{
  "name": "store-quality-control",
  "version": "1.0.0",
  "description": "门店品控管理系统",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "import:sample": "ts-node src/cli.ts import --type sample --file data/sample_retention.xlsx",
    "import:temperature": "ts-node src/cli.ts import --type temperature --file data/temperature_log.csv",
    "review": "ts-node src/cli.ts review",
    "export": "ts-node src/cli.ts export --output data/export",
    "test": "ts-node src/cli.ts test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "csv-parser": "^3.0.0",
    "sqlite3": "^5.1.7",
    "yargs": "^17.7.2",
    "date-fns": "^3.6.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sqlite3": "^3.1.11",
    "@types/yargs": "^17.0.32",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}