{
  "name": "import-validator-replayer",
  "version": "1.0.0",
  "description": "前端导入校验差异回放器 - 详细追踪每一行的导入结果",
  "main": "dist/server/index.js",
  "bin": {
    "import-validator": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc",
    "build:server": "tsc",
    "build:cli": "tsc",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "test": "jest",
    "lint": "eslint . --ext .ts,.vue"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "better-sqlite3": "^12.4.1",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "ajv": "^8.12.0",
    "uuid": "^9.0.1",
    "date-fns": "^3.3.1",
    "commander": "^12.0.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.8",
    "element-plus": "^2.6.1",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/better-sqlite3": "^7.6.9",
    "@types/papaparse": "^5.3.14",
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "ts-node-dev": "^2.0.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12"
  }
}