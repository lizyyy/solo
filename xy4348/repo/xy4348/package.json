{
  "name": "road-inspection-analyzer",
  "version": "1.0.0",
  "description": "路况勘察分析工具 - 用于分析骑行路线的风险路段",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"cd client && npm start\"",
    "install:all": "npm install && cd client && npm install"
